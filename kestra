id: execute_sap_and_copy_unc
namespace: prod.sap_integration

secret:
  SAP_PASS: "SAPPassword123"
  USER_UNC: "DOMAIN\\network_user"
  PASS_UNC: "NetworkPassword123"

triggers:
  - id: daily_schedule_berlin
    type: io.kestra.plugin.core.trigger.Schedule
    cron: "0 6 * * *"
    timezone: "Europe/Berlin"

tasks:
  - id: execute_and_extract_sap
    type: io.kestra.plugin.scripts.python.Script
    containerImage: python:3.11-slim
    beforeCommands:
      - apt-get update && apt-get install -y build-essential
      - pip install pyrfc pandas
    script: |
      import time
      from pyrfc import Connection

      # SAP connection configuration
      conn_params = {
          'ashost': '192.168.1.100',
          'sysnr': '00',
          'client': '100',
          'user': 'KESTRA_USER',
          'passwd': '{{ secret('SAP_PASS') }}'
      }

      report = "R3USER20"           # ABAP program/report name
      variant = "VAR_KESTRA"        # Variant name saved in SAP
      job_name = "KESTRA_EXPORT_JOB"

      print("Connecting to SAP...")
      with Connection(**conn_params) as conn:
          # 1. Create the Job
          res_open = conn.call('JOB_OPEN', JOBNAME=job_name)
          jobcount = res_open['JOBCOUNT']
          print(f"Job created. Name: {job_name}, Count: {jobcount}")

          # 2. Assign Report and Variant to Job
          conn.call(
              'JOB_SUBMIT',
              AUTHCKNAM='KESTRA_USER',
              JOBCOUNT=jobcount,
              JOBNAME=job_name,
              REPORT=report,
              VARIANT=variant
          )

          # 3. Release for immediate execution
          conn.call('JOB_CLOSE', JOBCOUNT=jobcount, JOBNAME=job_name, STRTIMMED='X')
          print("Job released in SAP. Waiting for completion...")

          # 4. Polling / Job status monitoring
          status = ""
          while status not in ['F', 'A']:  # F: Finished, A: Aborted
              time.sleep(5)
              res_read = conn.call('BAPI_SDBAP_JOB_STATUS_GET', JOBNAME=job_name, JOBCOUNT=jobcount)
              status = res_read.get('STATUS', '')
              print(f"Current Job status: {status}")

          if status == 'A':
              raise Exception("The SAP Job terminated abruptly (Aborted).")

          print("Job completed successfully. Downloading Spool / Result...")

          # 5. Download Spool generated by the Job
          spool_res = conn.call('BP_JOB_READ', JOBNAME=job_name, JOBCOUNT=jobcount)
          spoolid = spool_res['JOBSTEPTBL'][0]['SPOOLID']

          # Read spool content
          spool_data = conn.call('RSPO_RETURN_ABAP_SPOOLJOB', RQIDENT=spoolid)
          lines = [line['LINE'] for line in spool_data.get('BUFFER', [])]

          # Save local file in Kestra workspace
          output_filename = "sap_report_result.txt"
          with open(output_filename, "w", encoding="utf-8") as f:
              f.write("\n".join(lines))
          
          print(f"File generated successfully: {output_filename}")

  - id: copy_to_unc_path
    type: io.kestra.plugin.scripts.powershell.Script
    script: |
      $ErrorActionPreference = "Stop"

      $localFile = "sap_report_result.txt"
      $destinationUNC = "\\destination-server\shared\sap_reports"

      Write-Host "Connecting to UNC network share..."
      net use $destinationUNC "{{ secret('PASS_UNC') }}" /user:"{{ secret('USER_UNC') }}" /persistent:no

      try {
          Write-Host "Copying $localFile to $destinationUNC..."
          Copy-Item -Path $localFile -Destination "$destinationUNC\sap_report_$(Get-Date -Format 'yyyyMMdd_HHmmss').txt" -Force
          Write-Host "Copy completed successfully."
      }
      finally {
          Write-Host "Cleaning up network connections..."
          net use $destinationUNC /delete /y
      }
