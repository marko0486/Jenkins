import groovy.json.JsonSlurperClassic
import groovy.json.JsonOutput
import java.util.Calendar
import java.util.TimeZone

// ============================================================================
// Helpers
// ============================================================================
def formatTime(long millis) {
    if (millis <= 0) return "—"
    return new Date(millis).format('yyyy-MM-dd HH:mm:ss')
}

def formatDuration(long millis) {
    if (millis <= 0) return "—"
    long totalSeconds = (millis / 1000).longValue()
    long minutes = totalSeconds / 60
    long seconds = totalSeconds % 60
    if (minutes > 0) return "${minutes} min ${seconds} sec"
    return "${seconds} sec"
}

@NonCPS
def prependHistoryAndTrim(List history, Map entry, int maxEntries) {
    def out = new ArrayList()
    out.add(entry)
    history.each { h ->
        if (out.size() >= maxEntries) return
        out.add(h)
    }
    return out
}

def stripTrailingSlash(String p) {
    if (!p) return ''
    def s = p.trim()
    if (s.toLowerCase().startsWith('http://') || s.toLowerCase().startsWith('https://')) {
        while (s.endsWith('/')) s = s.substring(0, s.length() - 1)
        return s
    }
    while (s.endsWith('\\') || s.endsWith('/')) {
        s = s.substring(0, s.length() - 1)
    }
    return s
}

def FAILURE_COUNTS_FILE  = 'C:/Jenkins/Jobs/Dashboard/data/scheduler/failure-counts.json'
def SCHEDULE_FILE        = 'C:/Jenkins/Jobs/Dashboard/scheduled-jobs.json'
def MAX_FAILURES_PER_DAY = 10

@NonCPS
def berlinDateKey() {
    def tz = TimeZone.getTimeZone('Europe/Berlin')
    def cal = Calendar.getInstance(tz)
    return String.format('%04d-%02d-%02d',
        cal.get(Calendar.YEAR),
        cal.get(Calendar.MONTH) + 1,
        cal.get(Calendar.DAY_OF_MONTH))
}

@NonCPS
def berlinNowStamp() {
    def tz = TimeZone.getTimeZone('Europe/Berlin')
    def cal = Calendar.getInstance(tz)
    return String.format('%04d-%02d-%02d %02d:%02d:%02d',
        cal.get(Calendar.YEAR),
        cal.get(Calendar.MONTH) + 1,
        cal.get(Calendar.DAY_OF_MONTH),
        cal.get(Calendar.HOUR_OF_DAY),
        cal.get(Calendar.MINUTE),
        cal.get(Calendar.SECOND))
}

@NonCPS
def loadJsonMapSafe(String path) {
    def f = new File(path)
    if (!f.exists()) return new LinkedHashMap()
    def text = f.getText('UTF-8').trim()
    if (!text || text == '{}' || text == '[]') return new LinkedHashMap()
    def parsed = new JsonSlurperClassic().parseText(text)
    return (parsed instanceof Map) ? new LinkedHashMap(parsed) : new LinkedHashMap()
}

@NonCPS
def loadJsonListSafe(String path) {
    def f = new File(path)
    if (!f.exists()) return new ArrayList()
    def text = f.getText('UTF-8').trim()
    if (!text || text == '[]') return new ArrayList()
    def parsed = new JsonSlurperClassic().parseText(text)
    return (parsed instanceof List) ? new ArrayList(parsed) : new ArrayList()
}

@NonCPS
def writeJsonSafe(String path, Object data) {
    def f = new File(path)
    f.parentFile?.mkdirs()
    f.write(JsonOutput.prettyPrint(JsonOutput.toJson(data)), 'UTF-8')
}

def recordScheduledFailure(String jobName) {
    if (!jobName) return
    def today = berlinDateKey()
    def counts = loadJsonMapSafe(FAILURE_COUNTS_FILE)
    def entry = counts[jobName]
    if (!(entry instanceof Map) || entry.dateKey != today) {
        entry = [dateKey: today, count: 0, lastFailureAt: null]
    }
    entry.count = ((entry.count ?: 0) as int) + 1
    entry.lastFailureAt = berlinNowStamp()
    entry.dateKey = today
    counts[jobName] = entry
    writeJsonSafe(FAILURE_COUNTS_FILE, counts)
    echo "Failure count for ${jobName}: ${entry.count}/${MAX_FAILURES_PER_DAY} (day ${today} Europe/Berlin)"

    if ((entry.count as int) >= MAX_FAILURES_PER_DAY) {
        def jobs = loadJsonListSafe(SCHEDULE_FILE)
        def changed = false
        jobs.each { j ->
            def n = (j.name ?: j.job ?: '').toString()
            if (n == jobName) {
                j.enabled = false
                j.disabledByErrors = true
                j.disabledReason = "Disabled after ${MAX_FAILURES_PER_DAY} failures on ${today} (Europe/Berlin 00:00-23:59). Re-enable manually after fixing the issue."
                j.disabledAt = berlinNowStamp()
                changed = true
            }
        }
        if (changed) {
            writeJsonSafe(SCHEDULE_FILE, jobs)
            echo "AUTO-DISABLED job ${jobName} after ${entry.count} failures today."
        }
    }
}

// ============================================================================
// Pipeline
// ============================================================================
pipeline {
    agent {
        label 'Windows'
    }

    parameters {
        string(name: 'LOGICAL_JOB_NAME', defaultValue: '', description: 'Logical job name from scheduled-jobs.json')
        string(name: 'JOB_NAME',         defaultValue: '', description: 'Alias for LOGICAL_JOB_NAME')
        string(name: 'SRC_CRED',         defaultValue: 'WIN.SVC.UC4.BATCHUSER')
        string(name: 'SRC_PATH',         defaultValue: '')
        string(name: 'DST_PATH',         defaultValue: '')
        string(name: 'FILE_MASK',        defaultValue: '*.*')
        string(name: 'ROBOCOPY_FLAGS',   defaultValue: '/R:0 /W:0 /NP')
        string(name: 'PARENT_BUILD',     defaultValue: 'N/A')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    stages {
        stage('File Transfer') {
            steps {
                script {
                    def startMillis = System.currentTimeMillis()
                    env.START_MILLIS = "${startMillis}"
                    env.START_TIME_STR = formatTime(startMillis)

                    def jobName = (params.LOGICAL_JOB_NAME ?: params.JOB_NAME ?: 'UNKNOWN_JOB').toString().trim()
                    if (!jobName) jobName = 'UNKNOWN_JOB'
                    env.LOGICAL_NAME = jobName

                    def srcPath = stripTrailingSlash(params.SRC_PATH ?: '')
                    def dstPath = stripTrailingSlash(params.DST_PATH ?: '')
                    env.SRC_PATH_CLEAN = srcPath
                    env.DST_PATH_CLEAN = dstPath

                    currentBuild.displayName = "#${env.BUILD_NUMBER} - ${jobName}"
                    currentBuild.description = "${params.FILE_MASK}"

                    def logDir = 'C:\\Jenkins\\Jobs\\Log'
                    def logName = "${jobName}_BuildID_${env.BUILD_NUMBER}.txt"
                    def logPath = "${logDir}\\${logName}"
                    env.LOG_NAME = logName
                    env.LOG_PATH = logPath

                    env.FT_STATUS = 'FAILED'
                    env.FT_REASON = ''

                    bat """
@echo off
if not exist "${logDir}" mkdir "${logDir}"
"""

                    if (!srcPath || !dstPath) {
                        env.FT_STATUS = 'FAILED'
                        env.FT_REASON = 'SRC_PATH or DST_PATH is empty'
                        error(env.FT_REASON)
                    }

                    def rc = 0

                    withCredentials([
                        usernamePassword(
                            credentialsId: params.SRC_CRED,
                            usernameVariable: 'FT_USER',
                            passwordVariable: 'FT_PASS'
                        )
                    ]) {
                        bat """
@echo off
echo Authenticating UNC paths with ${params.SRC_CRED}
net use "${srcPath}" %FT_PASS% /user:%FT_USER% >nul 2>&1
if errorlevel 1 (
    for /f "tokens=1,2,3 delims=\\" %%a in ("${srcPath}") do (
        net use "\\\\%%b\\%%c" %FT_PASS% /user:%FT_USER% >nul 2>&1
    )
)
net use "${dstPath}" %FT_PASS% /user:%FT_USER% >nul 2>&1
if errorlevel 1 (
    for /f "tokens=1,2,3 delims=\\" %%a in ("${dstPath}") do (
        net use "\\\\%%b\\%%c" %FT_PASS% /user:%FT_USER% >nul 2>&1
    )
)
exit /b 0
"""

                        def srcCheck = bat(returnStatus: true, script: """
@echo off
dir /b "${srcPath}" >nul 2>&1
exit /b %ERRORLEVEL%
""")
                        if (srcCheck != 0) {
                            env.FT_STATUS = 'FAILED'
                            env.FT_REASON = "Source path not found or access denied: ${srcPath}"
                        } else {
                            def flags = (params.ROBOCOPY_FLAGS ?: '/R:0 /W:0 /NP').toString()
                            def mask = (params.FILE_MASK ?: '*.*').toString()

                            rc = bat(
                                returnStatus: true,
                                script: """
@echo off
robocopy "${srcPath}" "${dstPath}" ${mask} ${flags}
exit /b %ERRORLEVEL%
"""
                            )
                            // Robocopy: 0-7 OK-ish; 0 = nothing copied; >=8 failure
                            if (rc >= 8) {
                                env.FT_STATUS = 'FAILED'
                                env.FT_REASON = "Robocopy failed with RC=${rc}"
                            } else if (rc == 0) {
                                env.FT_STATUS = 'UNSTABLE'
                                env.FT_REASON = "No files matched mask or nothing to copy (RC=0)"
                            } else {
                                env.FT_STATUS = 'SUCCESS'
                                env.FT_REASON = ''
                            }
                        }

                        bat """
@echo off
net use "${srcPath}" /delete /y >nul 2>&1
net use "${dstPath}" /delete /y >nul 2>&1
for /f "tokens=1,2,3 delims=\\" %%a in ("${srcPath}") do net use "\\\\%%b\\%%c" /delete /y >nul 2>&1
for /f "tokens=1,2,3 delims=\\" %%a in ("${dstPath}") do net use "\\\\%%b\\%%c" /delete /y >nul 2>&1
exit /b 0
"""
                    }

                    if (env.FT_STATUS == 'FAILED') {
                        error(env.FT_REASON ?: 'Transfer FAILED')
                    } else if (env.FT_STATUS == 'UNSTABLE') {
                        unstable(env.FT_REASON ?: 'UNSTABLE')
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def startMillis = (env.START_MILLIS ?: '0').toLong()
                def endMillis = System.currentTimeMillis()
                def startTime = env.START_TIME_STR ?: formatTime(startMillis)
                def endTime = formatTime(endMillis)
                def duration = formatDuration(endMillis - startMillis)
                def elapsedSec = ((endMillis - startMillis) / 1000).longValue()

                def jobName = (env.LOGICAL_NAME ?: params.LOGICAL_JOB_NAME ?: params.JOB_NAME ?: 'UNKNOWN_JOB').toString()
                def logName = env.LOG_NAME ?: "${jobName}_BuildID_${env.BUILD_NUMBER}.txt"
                def logPath = env.LOG_PATH ?: "C:\\Jenkins\\Jobs\\Log\\${logName}"

                def status = (env.FT_STATUS ?: 'FAILED').toString().toUpperCase()
                if (currentBuild.currentResult == 'FAILURE' && status == 'SUCCESS') status = 'FAILED'
                if (currentBuild.currentResult == 'UNSTABLE' && status == 'SUCCESS') status = 'UNSTABLE'

                def failReason = null
                if (status != 'SUCCESS') {
                    failReason = env.FT_REASON ?: status
                }

                def logContent = """SUMMARY
================================================================================
Job Name     : ${jobName}
File Mask    : ${params.FILE_MASK}
SRC_PATH     : ${env.SRC_PATH_CLEAN ?: params.SRC_PATH}
DST_PATH     : ${env.DST_PATH_CLEAN ?: params.DST_PATH}
SRC_CRED     : ${params.SRC_CRED}
Status       : ${status}${failReason ? ' - ' + failReason : ''}
Duration     : ${elapsedSec} seconds
Timestamp    : ${new Date().format('yyyy-MM-dd HH:mm:ss')}
Parent       : ${params.PARENT_BUILD}
================================================================================
END OF LOG
"""
                writeFile file: logPath, text: logContent
                echo logContent

                def histDir  = "C:\\Jenkins\\Jobs\\Dashboard\\data\\scheduled\\${jobName}"
                def histFile = "${histDir}\\history.json"
                def histWork = "${env.WORKSPACE}\\history_temp_${env.BUILD_NUMBER}.json"

                bat """
@echo off
if not exist "${histDir}" mkdir "${histDir}"
if exist "${histFile}" (
    copy /Y "${histFile}" "${histWork}" >nul
) else (
    echo []> "${histWork}"
)
"""
                def history = []
                try {
                    def raw = readFile(file: histWork).trim()
                    if (raw && raw != '[]') {
                        def parsed = new JsonSlurperClassic().parseText(raw)
                        if (parsed instanceof List) history = new ArrayList(parsed)
                    }
                } catch (Exception e) {
                    echo "WARNING: could not parse history: ${e.message}"
                    history = []
                }

                def entry = [
                    build     : env.BUILD_NUMBER.toInteger(),
                    startTime : startTime,
                    endTime   : endTime,
                    duration  : duration,
                    status    : status,
                    logFile   : logName,
                    reason    : failReason
                ]
                history = prependHistoryAndTrim(history, entry, 20)
                writeFile file: histWork, text: JsonOutput.prettyPrint(JsonOutput.toJson(history))
                bat """
@echo off
copy /Y "${histWork}" "${histFile}" >nul
"""
                echo "Scheduled history updated: ${histFile} status=${status}"

                if (status == 'FAILED') {
                    recordScheduledFailure(jobName)
                }
            }
        }
    }
}
