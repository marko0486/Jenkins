Sustituye el stage('File Transfer') / script por esto:

        stage('File Transfer') {
            steps {
                script {
                    def startMs = System.currentTimeMillis()
                    def startTime = formatTime(startMs)

                    def jobName = (params.LOGICAL_JOB_NAME?.trim()) ? params.LOGICAL_JOB_NAME.trim() : env.JOB_NAME
                    def srcPath = (params.SRC_PATH ?: '').toString().trim()
                    def dstPath = (params.DST_PATH ?: '').toString().trim()
                    def fileMask = (params.FILE_MASK ?: '*.*').toString().trim()
                    def roboFlags = (params.ROBOCOPY_FLAGS ?: '/R:0 /W:0 /NP').toString().trim()
                    def credId = (params.SRC_CRED ?: 'WIN.SVC.UC4.BATCHUSER').toString().trim()

                    echo "LOGICAL_JOB_NAME : ${jobName}"
                    echo "SRC_PATH         : ${srcPath}"
                    echo "DST_PATH         : ${dstPath}"
                    echo "FILE_MASK        : ${fileMask}"
                    echo "ROBOCOPY_FLAGS   : ${roboFlags}"
                    echo "PARENT_BUILD     : ${params.PARENT_BUILD}"

                    def status = 'SUCCESS'
                    def failReason = null
                    def fullLog = ''
                    def rc = 0

                    if (!srcPath) {
                        status = 'FAILED'
                        failReason = 'Source path is empty'
                    } else if (!dstPath) {
                        status = 'FAILED'
                        failReason = 'Destination path is empty'
                    } else {
                        withCredentials([usernamePassword(
                            credentialsId: credId,
                            usernameVariable: 'FT_USER',
                            passwordVariable: 'FT_PASS'
                        )]) {
                            // 1) Authenticate SMB session FIRST (required for UNC)
                            bat """
@echo off
net use "${srcPath}" /user:%FT_USER% %FT_PASS% >nul 2>&1
net use "${dstPath}" /user:%FT_USER% %FT_PASS% >nul 2>&1
"""

                            // 2) Path check AFTER net use (dir is more reliable than "if not exist" on UNC)
                            def checkSrc = bat(
                                returnStatus: true,
                                script: """
@echo off
dir /b "${srcPath}" >nul 2>&1
exit /b %ERRORLEVEL%
"""
                            )
                            def checkDst = bat(
                                returnStatus: true,
                                script: """
@echo off
dir /b "${dstPath}" >nul 2>&1
exit /b %ERRORLEVEL%
"""
                            )

                            if (checkSrc != 0) {
                                status = 'FAILED'
                                failReason = "Source path not found or access denied: ${srcPath}"
                                echo "PATH CHECK FAILED (src): RC=${checkSrc}"
                                fullLog = "Skipped Robocopy.\nREASON: ${failReason}"
                            } else if (checkDst != 0) {
                                status = 'FAILED'
                                failReason = "Destination path not found or access denied: ${dstPath}"
                                echo "PATH CHECK FAILED (dst): RC=${checkDst}"
                                fullLog = "Skipped Robocopy.\nREASON: ${failReason}"
                            } else {
                                // 3) Robocopy
                                def outFile = "${env.WORKSPACE}\\robocopy_out.txt"
                                def cmd = "robocopy \"${srcPath}\" \"${dstPath}\" ${fileMask} ${roboFlags}"
                                echo "EXEC: ${cmd}"

                                rc = bat(
                                    returnStatus: true,
                                    script: """
@echo off
${cmd} > "${outFile}" 2>&1
exit /b %ERRORLEVEL%
"""
                                )

                                try {
                                    fullLog = readFile(file: outFile)
                                } catch (Exception e) {
                                    fullLog = "(could not read robocopy output: ${e.message})"
                                }

                                // Robocopy: 0-7 = OK, >= 8 = error
                                if (rc >= 8) {
                                    status = 'FAILED'
                                    failReason = "Robocopy failed with RC=${rc}"
                                    echo "ROBOCOPY FAILED: RC=${rc}"
                                } else {
                                    status = 'SUCCESS'
                                    failReason = null
                                    echo "ROBOCOPY OK: RC=${rc}"
                                }
                            }
                        }
                    }

                    def endMs = System.currentTimeMillis()
                    def endTime = formatTime(endMs)
                    def duration = formatDuration(endMs - startMs)
                    def elapsedSec = ((endMs - startMs) / 1000).longValue()

                    // ---- Log file ----
                    def logDir  = 'C:\\Jenkins\\Jobs\\Log'
                    def logName = "${jobName}_BuildID_${env.BUILD_NUMBER}.txt"
                    def logPath = "${logDir}\\${logName}"

                    bat """
@echo off
if not exist "${logDir}" mkdir "${logDir}"
"""

                    def logContent = """SUMMARY
================================================================================
Job Name     : ${jobName}
File Mask    : ${fileMask}
SRC_PATH     : ${srcPath}
DST_PATH     : ${dstPath}
SRC_CRED     : ${credId}
Status       : ${status}
Reason       : ${failReason ?: '—'}
Duration     : ${elapsedSec} seconds
Timestamp    : ${endTime}
Parent       : ${params.PARENT_BUILD ?: '—'}
Robocopy RC  : ${rc}
-------------------------------------------------------------------------------
${fullLog}
================================================================================
END OF LOG
"""
                    writeFile file: logPath, text: logContent
                    echo "Detailed log written to: ${logPath}"

                    // ---- history.json ----
                    def histDir  = "C:\\Jenkins\\Jobs\\Dashboard\\data\\scheduled\\${jobName}"
                    def histFile = "${histDir}\\history.json"
                    def histWork = "${env.WORKSPACE}\\history_temp.json"

                    bat """
@echo off
if not exist "${histDir}" mkdir "${histDir}"
if exist "${histFile}" (
    copy /Y "${histFile}" "${histWork}" >nul
) else (
    echo []> "${histWork}"
)
"""

                    def history = []
                    try {
                        def raw = readFile(file: histWork).trim()
                        if (raw && raw != '[]') {
                            def parsed = new JsonSlurperClassic().parseText(raw)
                            if (parsed instanceof List) {
                                history = new ArrayList(parsed)
                            }
                        }
                    } catch (Exception e) {
                        echo "WARNING: could not parse history: ${e.message}"
                        history = []
                    }

                    def entry = [
                        build     : env.BUILD_NUMBER.toInteger(),
                        startTime : startTime,
                        endTime   : endTime,
                        duration  : duration,
                        status    : status,
                        logFile   : logName,
                        reason    : failReason
                    ]
                    history = prependHistoryAndTrim(history, entry, 20)

                    writeFile file: histWork, text: JsonOutput.prettyPrint(JsonOutput.toJson(history))
                    bat """
@echo off
copy /Y "${histWork}" "${histFile}" >nul
"""
                    echo "Scheduled history updated: ${histFile}"
                    echo "Final status: ${status}"

                    if (status == 'FAILED') {
                        error("Transfer FAILED: ${failReason ?: 'see log'}")
                    }
                }
            }
        }
