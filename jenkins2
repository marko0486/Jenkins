version 1.0

pipeline {

    // ============================================================
    // AGENT
    // ============================================================
    agent {
        label 'Windows'
    }

    // ============================================================
    // PARAMETERS
    // ============================================================
    parameters {

        string(
            name: 'JOB_NAME',
            defaultValue: ''
        )

        string(
            name: 'SRC_PATH',
            defaultValue: ''
        )

        string(
            name: 'SITE_URL',
            defaultValue: ''
        )

        string(
            name: 'LIBRARY',
            defaultValue: 'Shared Documents'
        )

        string(
            name: 'FILE_MASK',
            defaultValue: '*.*'
        )

        choice(
            name: 'OPERATION',
            choices: [
                'COPY',
                'MOVE'
            ]
        )

        booleanParam(
            name: 'OVERWRITE',
            defaultValue: true
        )

    } // end parameters

    // ============================================================
    // OPTIONS
    // ============================================================
    options {

        buildDiscarder(
            logRotator(
                numToKeepStr: '50'
            )
        )

    } // end options

    // ============================================================
    // STAGES
    // ============================================================
    stages {

        // --------------------------------------------------------
        // STAGE: SharePoint Transfer
        // --------------------------------------------------------
        stage('SharePoint Transfer') {

            steps {

                // Make the stage UNSTABLE instead of FAILURE if something fails
                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'UNSTABLE'
                ) {

                    script {

                        // ------------------------------------------------
                        // Calculate start time (safer than environment block)
                        // ------------------------------------------------
                        def startTime = System.currentTimeMillis()
                        env.START_TIME = "${startTime}"

                        // ------------------------------------------------
                        // Set build display name and description
                        // ------------------------------------------------
                        currentBuild.displayName = "#${env.BUILD_NUMBER} - ${params.JOB_NAME}"
                        currentBuild.description = "${params.FILE_MASK}"

                        // ------------------------------------------------
                        // Define temporary folder and file paths
                        // ------------------------------------------------
                        def tmpDir = "C:\\Jenkins\\Jobs\\Tmp"

                        // Fixed PowerShell script name (no BUILD_NUMBER)
                        def psFile = "${tmpDir}\\sharepoint-transfer.ps1"

                        // Log files with buildID_ + BUILD_NUMBER format
                        def uploadedFile = "${tmpDir}\\uploaded_files_buildID_${env.BUILD_NUMBER}.txt"
                        def skippedFile  = "${tmpDir}\\skipped_files_buildID_${env.BUILD_NUMBER}.txt"
                        def errorFile    = "${tmpDir}\\sharepoint_error_buildID_${env.BUILD_NUMBER}.txt"

                        // ------------------------------------------------
                        // Create temporary folder if it does not exist
                        // ------------------------------------------------
                        bat """
@echo off
if not exist "${tmpDir}" mkdir "${tmpDir}"
"""

                        // ------------------------------------------------
                        // Generate the PowerShell script content
                        // ------------------------------------------------
                        writeFile(
                            file: psFile,
                            text: """
# ================================================================
# SharePoint Transfer Script
# Generated by Jenkins Pipeline
# ================================================================

\$clientId   = "c9864df8-7369-42e5-bec4-2a7fd1e6cf7a"
\$tenantId   = "eb70b763-b6d7-4486-8555-8831709a784e"
\$thumbPrint = "30da72f8c36269bdcc7e8aefcc577c0ef51eef90"

\$ErrorActionPreference = "Stop"

# Read environment variables passed from Jenkins
\$siteUrl   = \$env:SITE_URL
\$source    = \$env:SRC_PATH
\$mask      = \$env:FILE_MASK
\$library   = \$env:LIBRARY
\$operation = \$env:OPERATION

# Convert OVERWRITE string to real boolean
\$overwrite = [System.Convert]::ToBoolean(\$env:OVERWRITE)

\$connected = \$false
\$uploaded  = @()
\$skipped   = @()

# Log file paths (injected by Jenkins)
\$uploadedFile = "${uploadedFile}"
\$skippedFile  = "${skippedFile}"
\$errorFile    = "${errorFile}"

try {

    # Validate source path exists
    if (-not (Test-Path \$source)) {
        throw "Source path does not exist: \$source"
    }

    # Connect to SharePoint Online using certificate authentication
    Connect-PnPOnline `
        -Url \$siteUrl `
        -ClientId \$clientId `
        -Tenant \$tenantId `
        -Thumbprint \$thumbPrint `
        -ErrorAction Stop

    \$connected = \$true

    # Simple connectivity check
    Get-PnPWeb -ErrorAction Stop | Out-Null

    # Force array even if only one file is found
    \$files = @(Get-ChildItem -Path \$source -Filter \$mask -File)

    if (\$files.Count -eq 0) {
        throw "No files found matching: \$mask"
    }

    # Process each file
    foreach (\$file in \$files) {

        Write-Host ""
        Write-Host "Uploading: \$(\$file.Name)"
        Write-Host "Operation: \$operation"

        if (\$overwrite) {
            # Always overwrite existing files
            Add-PnPFile `
                -Path \$file.FullName `
                -Folder \$library `
                -ErrorAction Stop
        }
        else {
            # Check if file already exists (file-by-file = better performance)
            \$existingFile = Get-PnPFile `
                -Url "\$library/\$(\$file.Name)" `
                -AsListItem `
                -ErrorAction SilentlyContinue

            if (\$existingFile) {
                \$skipped += \$file.Name
                Write-Host "Skipped (already exists): \$(\$file.Name)"
                continue
            }

            # Upload because file does not exist
            Add-PnPFile `
                -Path \$file.FullName `
                -Folder \$library `
                -ErrorAction Stop
        }

        # Track successfully uploaded file
        \$uploaded += \$file.Name

        # If operation is MOVE, delete local file after successful upload
        if (\$operation -eq 'MOVE') {
            Remove-Item -Path \$file.FullName -Force -ErrorAction Stop
        }

    } # end foreach

    # Write results to log files
    \$uploaded | Set-Content -Path \$uploadedFile -Encoding UTF8
    \$skipped  | Set-Content -Path \$skippedFile  -Encoding UTF8

}
catch {

    # Save error message to error log file
    \$_.Exception.Message | Set-Content -Path \$errorFile -Encoding UTF8
    exit 1

}
finally {

    # Always disconnect from SharePoint if connected
    if (\$connected) {
        Disconnect-PnPOnline -ErrorAction SilentlyContinue
    }

}

exit 0
"""
                        ) // end writeFile

                        // ------------------------------------------------
                        // Export parameters as environment variables
                        // and execute the PowerShell script
                        // ------------------------------------------------
                        withEnv([
                            "SITE_URL=${params.SITE_URL}",
                            "SRC_PATH=${params.SRC_PATH}",
                            "FILE_MASK=${params.FILE_MASK}",
                            "LIBRARY=${params.LIBRARY}",
                            "OPERATION=${params.OPERATION}",
                            "OVERWRITE=${params.OVERWRITE}"
                        ]) {

                            def rc = bat(
                                returnStatus: true,
                                script: """
@echo off
"C:\\Program Files\\PowerShell\\7\\pwsh.exe" ^
    -NoLogo ^
    -NoProfile ^
    -NonInteractive ^
    -ExecutionPolicy Bypass ^
    -File "${psFile}"
exit /b %ERRORLEVEL%
"""
                            )

                            // Fail the stage if PowerShell returned non-zero
                            if (rc != 0) {
                                error("SharePoint transfer failed. RC=${rc}")
                            }

                        } // end withEnv

                    } // end script

                } // end catchError

            } // end steps

        } // end stage('SharePoint Transfer')

    } // end stages

    // ============================================================
    // POST ACTIONS
    // ============================================================
    post {

        always {

            script {

                // Calculate elapsed time in seconds
                long elapsed = (System.currentTimeMillis() - env.START_TIME.toLong()) / 1000

                def tmpDir = "C:\\Jenkins\\Jobs\\Tmp"

                def uploadedFile = "${tmpDir}\\uploaded_files_buildID_${env.BUILD_NUMBER}.txt"
                def skippedFile  = "${tmpDir}\\skipped_files_buildID_${env.BUILD_NUMBER}.txt"
                def errorFile    = "${tmpDir}\\sharepoint_error_buildID_${env.BUILD_NUMBER}.txt"

                def uploadedFiles = ''
                def skippedFiles  = ''
                def errorMsg      = ''
                def finalStatus   = ''

                // Read uploaded files log (if exists)
                if (fileExists(uploadedFile)) {
                    uploadedFiles = readFile(uploadedFile).trim()
                }

                // Read skipped files log (if exists)
                if (fileExists(skippedFile)) {
                    skippedFiles = readFile(skippedFile).trim()
                }

                // Read error log (if exists)
                if (fileExists(errorFile)) {
                    errorMsg = readFile(errorFile).trim()
                }

                // Decide final status message
                if (errorMsg?.trim()) {
                    finalStatus = errorMsg
                }
                else if (!uploadedFiles?.trim() && skippedFiles?.trim()) {
                    finalStatus = 'NO FILES PROCESSED'
                }
                else if (!uploadedFiles?.trim() && !skippedFiles?.trim()) {
                    finalStatus = 'NO FILES PROCESSED'
                }
                else {
                    finalStatus = "SUCCESS (${params.OPERATION})"
                }

                // Build and print summary
                def summary = """SUMMARY

========================================
Job Name  : ${params.JOB_NAME}
Site URL  : ${params.SITE_URL}
Library   : ${params.LIBRARY}
Operation : ${params.OPERATION}
File Mask : ${params.FILE_MASK}
Status    : ${finalStatus}
Duration  : ${elapsed} seconds

Uploaded Files
----------------------------------------
${uploadedFiles?.trim() ? uploadedFiles : 'No files uploaded'}

Skipped Files
----------------------------------------
${skippedFiles?.trim() ? skippedFiles : 'No files skipped'}

========================================
"""

                echo(summary)

            } // end script

        } // end always

    } // end post

} // end pipeline
