Todavia sigue sin lanzar el otro job,
Te voy a pegar los dos jobs, y has los cambios prudentes,
Quiero que el job padre llamado: POC_AUTOMIC_FT_ORCHESTRATOR_05_MINUTES.EV ejecute los jobs del json
si es  "transferType": "ROBOCOPY" que ejecute: POC_AUTOMIC_FILE_TRANSFER_IMPROVED_PEFORMANCE
Si es "transferType": "SHAREPOINT",   que ejecute POC_SHAREPOINT_TRANSFER

Te adjunto el codigo de POC_AUTOMIC_FT_ORCHESTRATOR_05_MINUTES.EV

import groovy.json.JsonSlurperClassic

// ============================================================================
// GLOBAL EXECUTION COUNTERS AND LISTS
// ============================================================================
def TOTAL          = 0
def DISABLED       = 0
def CHECKED        = 0
def EXECUTED       = 0
def SKIPPED        = 0
def FAILURES       = []
def DISABLED_JOBS  = []
def SKIPPED_JOBS   = []
def SUCCESS_JOBS   = []

pipeline {
    agent {
        label 'built-in'
    }
    options {
        disableConcurrentBuilds()
    }
    stages {
        stage('File Transfers') {
            steps {
                script {
                    def jsonText = new File('C:/Jenkins/Jobs/tmp.json').text
                    def transfers = new JsonSlurperClassic().parseText(jsonText)
                    TOTAL = transfers.size()

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'WIN.SVC.UC4.BATCHUSER',
                            usernameVariable: 'FT_USER',
                            passwordVariable: 'FT_PASS'
                        )
                    ]) {
                        try {
                            transfers.each { transfer ->

                                if (transfer.containsKey('enabled') && !transfer.enabled) {
                                    DISABLED++
                                    DISABLED_JOBS << transfer.job?.toString()
                                    echo "[DISABLED] ${transfer.job}"
                                    return
                                }

                                String jobName       = transfer.job?.toString()
                                String credentialId  = transfer.credentialId?.toString()
                                String source        = transfer.source?.toString()
                                String destination   = transfer.destination?.toString()
                                String fileMask      = transfer.fileMask?.toString() ?: '*.*'
                                String transferType  = transfer.transferType?.toString()?.trim()?.toUpperCase() ?: 'ROBOCOPY'
                                String roboFlags     = ''

                                if (transfer.flags instanceof List) {
                                    roboFlags = transfer.flags.collect { it.toString() }.join(' ')
                                } else {
                                    roboFlags = transfer.flags?.toString() ?: ''
                                }

                                // ============================================================
                                // PRE-CHECK (only for ROBOCOPY with the common credential)
                                // ============================================================
                                if (transferType == 'ROBOCOPY' && credentialId == 'WIN.SVC.UC4.BATCHUSER') {
                                    CHECKED++
                                    int checkResult = bat(
                                        returnStatus: true,
                                        script: """
@echo off
setlocal EnableDelayedExpansion
set "SOURCE=${source}"
set "FILEMASK=${fileMask}"

REM Extraer \\server\\share de forma robusta
set "TEMP=!SOURCE:~2!"
for /f "tokens=1,2 delims=\\" %%a in ("!TEMP!") do (
    set "SERVER=%%a"
    set "SHARENAME=%%b"
)
set "SHARE=\\\\!SERVER!\\!SHARENAME!"

REM Limpiar conexión previa
net use "!SHARE!" /delete /y >nul 2>&1

REM Autenticar
net use "!SHARE!" "%FT_PASS%" /user:"%FT_USER%" >nul 2>&1
if errorlevel 1 (
    exit /b 100
)

REM Entrar al path
pushd "!SOURCE!" >nul 2>&1
if errorlevel 1 (
    net use "!SHARE!" /delete /y >nul 2>&1
    exit /b 100
)

REM Comprobación fiable de existencia de archivos
dir /b /a-d "!FILEMASK!" >nul 2>&1
set "RC=!ERRORLEVEL!"

popd >nul 2>&1
net use "!SHARE!" /delete /y >nul 2>&1

exit /b !RC!
"""
                                    )

                                    if (checkResult == 100) {
                                        FAILURES << [
                                            job    : jobName,
                                            result : 'PRECHECK_FAILED',
                                            reason : 'Source path not found or access denied'
                                        ]
                                        echo "[FAIL] ${jobName}"
                                        return
                                    }
                                    if (checkResult != 0) {
                                        SKIPPED++
                                        SKIPPED_JOBS << jobName
                                        echo "[SKIP] ${jobName} (no files matching mask)"
                                        return
                                    }
                                }

                                echo "[EXEC] ${jobName} (${transferType})"

                                def result
                                if (transferType == 'SHAREPOINT') {
                                    result = build(
                                        job: 'POC_SHAREPOINT_TRANSFER',
                                        wait: true,
                                        propagate: false,
                                        parameters: [
                                            string(name: 'JOB_NAME',     value: jobName),
                                            string(name: 'SRC_PATH',     value: source),
                                            string(name: 'SITE_URL',     value: destination),
                                            string(name: 'LIBRARY',      value: transfer.library?.toString() ?: 'Shared Documents'),
                                            string(name: 'FILE_MASK',    value: fileMask),
                                            string(name: 'OPERATION',    value: transfer.operation?.toString()?.toUpperCase() ?: 'COPY'),
                                            booleanParam(name: 'OVERWRITE', value: transfer.overwrite != false),
                                            string(name: 'SRC_CRED',     value: credentialId ?: 'WIN.SVC.UC4.BATCHUSER'),
                                            string(name: 'PARENT_BUILD', value: "${env.BUILD_NUMBER}")
                                        ]
                                    )
                                } else {
                                    result = build(
                                        job: 'POC_AUTOMIC_FILE_TRANSFER_IMPROVED_PEFORMANCE',
                                        wait: true,
                                        propagate: false,
                                        parameters: [
                                            string(name: 'JOB_NAME',        value: jobName),
                                            string(name: 'SRC_CRED',        value: credentialId),
                                            string(name: 'SRC_PATH',        value: source),
                                            string(name: 'DST_PATH',        value: destination),
                                            string(name: 'FILE_MASK',       value: fileMask),
                                            string(name: 'ROBOCOPY_FLAGS',  value: roboFlags)
                                        ]
                                    )
                                }

                                EXECUTED++
                                if (result.result != 'SUCCESS') {
                                    FAILURES << [
                                        job    : jobName,
                                        result : result.result,
                                        build  : result.number,
                                        url    : result.absoluteUrl,
                                        reason : "Transfer returned ${result.result}"
                                    ]
                                    echo "[FAIL] ${jobName}"
                                } else {
                                    SUCCESS_JOBS << jobName
                                    echo "[SUCCESS] ${jobName}"
                                }
                            }
                        } finally {
                            // Optional: clean up mappings if needed
                        }
                    }

                    currentBuild.displayName = "#${env.BUILD_NUMBER} D:${DISABLED} X:${EXECUTED} S:${SKIPPED} F:${FAILURES.size()}"
                    currentBuild.description = "Total=${TOTAL} | Disabled=${DISABLED} | Checked=${CHECKED} | Executed=${EXECUTED} | Skipped=${SKIPPED} | Failed=${FAILURES.size()}"
                    currentBuild.result = 'SUCCESS'
                }
            }
        }
    }
    post {
        always {
            script {
                def summary = """
FT SUMMARY
========================================
FILE TRANSFER SUMMARY
========================================
Total    : ${TOTAL}
Disabled : ${DISABLED}
Checked  : ${CHECKED}
Executed : ${EXECUTED}
Skipped  : ${SKIPPED}
Failed   : ${FAILURES.size()}
========================================
"""
                if (!FAILURES.isEmpty()) {
                    summary += """
FAILED JOBS
========================================
"""
                    FAILURES.each { f ->
                        summary += """
JOB    : ${f.job}
RESULT : ${f.result}
REASON : ${f.reason}
----------------------------------------
"""
                    }
                    summary += "========================================\n"
                }
                echo(summary)

                // Detailed log file
                def logDir = 'C:\\Jenkins\\Jobs\\Log'
                def dateStr = new Date().format('yyyyMMdd')
                def logFileName = "${env.JOB_NAME}_${dateStr}_BuildID_${env.BUILD_NUMBER}.txt"
                def logFilePath = "${logDir}\\${logFileName}"

                bat """
@echo off
if not exist "${logDir}" mkdir "${logDir}"
"""

                def logContent = """
================================================================================
FILE TRANSFER ORCHESTRATOR - DETAILED EXECUTION LOG
================================================================================
Job Name      : ${env.JOB_NAME}
Build Number  : ${env.BUILD_NUMBER}
Build URL     : ${env.BUILD_URL}
Timestamp     : ${new Date().format('yyyy-MM-dd HH:mm:ss')}
================================================================================
SUMMARY
--------------------------------------------------------------------------------
Total     : ${TOTAL}
Disabled  : ${DISABLED}
Checked   : ${CHECKED}
Executed  : ${EXECUTED}
Skipped   : ${SKIPPED}
Failed    : ${FAILURES.size()}
--------------------------------------------------------------------------------
DISABLED JOBS (${DISABLED})
--------------------------------------------------------------------------------
"""
                if (DISABLED_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    DISABLED_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
SKIPPED JOBS (${SKIPPED})
--------------------------------------------------------------------------------
"""
                if (SKIPPED_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    SKIPPED_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
SUCCESSFULLY EXECUTED JOBS (${SUCCESS_JOBS.size()})
--------------------------------------------------------------------------------
"""
                if (SUCCESS_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    SUCCESS_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
FAILED JOBS (${FAILURES.size()})
--------------------------------------------------------------------------------
"""
                if (FAILURES.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    FAILURES.each { f ->
                        logContent += """
  JOB     : ${f.job}
  RESULT  : ${f.result}
  REASON  : ${f.reason}
"""
                        if (f.build) logContent += "  BUILD   : #${f.build}\n"
                        if (f.url)   logContent += "  URL     : ${f.url}\n"
                        logContent += "  ----------------------------------------\n"
                    }
                }

                logContent += """
================================================================================
END OF LOG
================================================================================
"""
                writeFile file: logFilePath, text: logContent
                echo "Detailed log written to: ${logFilePath}"
            }
        }
    }
}


codigo de: POC_AUTOMIC_FILE_TRANSFER_IMPROVED_PEFORMANCE
pipeline {

    //
    // Execute this job on any Windows agent capable of
    // running SMB commands and Robocopy.
    //
    agent {
        label 'Windows'
    }

    //
    // Parameters provided by the Orchestrator.
    //
    // JOB_NAME
    //   Logical transfer identifier.
    //
    // SRC_CRED
    //   Jenkins credential ID used for SMB authentication.
    //
    // SRC_PATH
    //   Full UNC source path.
    //   Example:
    //   \\server\share\folder
    //
    // DST_PATH
    //   Full UNC destination path.
    //
    // FILE_MASK
    //   File selection pattern passed to Robocopy.
    //   Examples:
    //   *.csv
    //   *.txt
    //   *.*
    //
    // ROBOCOPY_FLAGS
    //   Additional Robocopy options.
    //   Examples:
    //   /MOV /R:0 /W:0
    //   /E /XO
    //
    parameters {

        string(
            name: 'JOB_NAME',
            defaultValue: ''
        )

        string(
            name: 'SRC_CRED',
            defaultValue: ''
        )

        string(
            name: 'SRC_PATH',
            defaultValue: ''
        )

        string(
            name: 'DST_PATH',
            defaultValue: ''
        )

        string(
            name: 'FILE_MASK',
            defaultValue: '*.*'
        )

        string(
            name: 'ROBOCOPY_FLAGS',
            defaultValue: ''
        )
    }

    //
    // Keep only the latest 50 executions.
    //
    options {

        buildDiscarder(
            logRotator(
                numToKeepStr: '50'
            )
        )
    }

    environment {

        //
        // Used later to calculate execution duration.
        //
        START_TIME = "${System.currentTimeMillis()}"
    }

    stages {

        stage('Transfer Definition') {

            steps {

                //
                // Convert runtime failures into UNSTABLE
                // instead of failing the entire build.
                //
                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'UNSTABLE'
                ) {

                    script {

                        //
                        // Customize Jenkins UI.
                        //
                        // Example:
                        // #125 - ZF.FILE_TRANSFER_JOB
                        //
                        currentBuild.displayName =
                            "#${env.BUILD_NUMBER} - ${params.JOB_NAME}"

                        //
                        // Human readable transfer description.
                        //
                        currentBuild.description =
                            "${params.FILE_MASK} : ${params.SRC_PATH} -> ${params.DST_PATH}"

                        //
                        // Retrieve all username/password credentials
                        // available in Jenkins.
                        //
                        def creds =
                            com.cloudbees.plugins.credentials.CredentialsProvider.lookupCredentials(
                                com.cloudbees.plugins.credentials.common.StandardUsernamePasswordCredentials.class,
                                jenkins.model.Jenkins.get(),
                                null,
                                null
                            )

                        //
                        // Locate the credential requested by SRC_CRED.
                        //
                        def cred = creds.find {
                            it.id == params.SRC_CRED
                        }

                        //
                        // Store values in environment variables so
                        // they can be accessed later in the pipeline.
                        //
                        env.FT_USERNAME =
                            cred ? cred.username : "UNKNOWN"

                        env.CREDENTIAL_ID =
                            cred ? cred.id : ""

                        //
                        // Stop early if the credential does not exist.
                        //
                        if (!env.CREDENTIAL_ID?.trim()) {

                            writeFile(
                                file: 'robocopy.error',
                                text: "Credential not found for ID: ${params.SRC_CRED}"
                            )

                            unstable(
                                "Credential not found for ID: ${params.SRC_CRED}"
                            )

                            return
                        }

                        //
                        // Normalize Robocopy options.
                        //
                        env.ROBOCOPY_OPTIONS =
                            params.ROBOCOPY_FLAGS?.trim() ?: ""

                        //
                        // Parse source UNC path.
                        //
                        // Example:
                        // \\server\share\folder
                        //
                        // Results:
                        // server = srcParts[0]
                        // share  = srcParts[1]
                        //
                        def srcParts = params.SRC_PATH
                            .replaceFirst('^\\\\\\\\', '')
                            .split('\\\\')

                        //
                        // A valid UNC path requires at least:
                        // server + share
                        //
                        if (srcParts.size() < 2) {

                            writeFile(
                                file: 'robocopy.error',
                                text: 'Invalid source UNC path.'
                            )

                            unstable(
                                'Invalid source UNC path.'
                            )

                            return
                        }

                        //
                        // Root share used by NET USE.
                        //
                        // Example:
                        // \\server\share
                        //
                        env.SRC_SHARE_ROOT =
                            "\\\\${srcParts[0]}\\${srcParts[1]}"

                        //
                        // Parse destination UNC path.
                        //
                        def dstParts = params.DST_PATH
                            .replaceFirst('^\\\\\\\\', '')
                            .split('\\\\')

                        //
                        // Destination share root.
                        //
                        if (dstParts.size() >= 2) {

                            env.DST_SHARE_ROOT =
                                "\\\\${dstParts[0]}\\${dstParts[1]}"

                        } else {

                            //
                            // Fallback.
                            //
                            env.DST_SHARE_ROOT =
                                env.SRC_SHARE_ROOT
                        }

                        //
                        // Transfer definition shown in console log.
                        //
                        echo "========================================"
                        echo "Job Name      : ${params.JOB_NAME}"
                        echo "User          : ${env.FT_USERNAME}"
                        echo "Credential ID : ${params.SRC_CRED}"
                        echo "Source        : ${params.SRC_PATH}"
                        echo "Destination   : ${params.DST_PATH}"
                        echo "File Mask     : ${params.FILE_MASK}"
                        echo "Robocopy Flags: ${env.ROBOCOPY_OPTIONS}"
                        echo "========================================"

                        //
                        // Load username/password into FT_USER
                        // and FT_PASS.
                        //
                        withCredentials([
                            usernamePassword(
                                credentialsId: env.CREDENTIAL_ID,
                                usernameVariable: 'FT_USER',
                                passwordVariable: 'FT_PASS'
                            )
                        ]) {

                            //
                            // Execute SMB access validation and Robocopy.
                            //
                            def rc = bat(
                                returnStatus: true,
                                script: """
@echo off

if exist robocopy.error del robocopy.error
if exist robocopy.rc del robocopy.rc

rem Connect to source share.
net use "%SRC_SHARE_ROOT%" %FT_PASS% /user:%FT_USER% >nul 2>&1

if errorlevel 1 (
    exit /b 101
)

rem Connect to destination share only when different.
if /I NOT "%SRC_SHARE_ROOT%"=="%DST_SHARE_ROOT%" (

    net use "%DST_SHARE_ROOT%" %FT_PASS% /user:%FT_USER% >nul 2>&1

    if errorlevel 1 (
        exit /b 102
    )
)

rem Validate source path.
dir "${params.SRC_PATH}" >nul 2>&1

if errorlevel 1 (
    exit /b 103
)

rem Validate destination path.
dir "${params.DST_PATH}" >nul 2>&1

if errorlevel 1 (
    exit /b 104
)

rem Execute Robocopy.
robocopy "${params.SRC_PATH}" "${params.DST_PATH}" "${params.FILE_MASK}" ${env.ROBOCOPY_OPTIONS} > robocopy.log

set RC=%ERRORLEVEL%

echo %RC% > robocopy.rc

rem Disconnect SMB sessions.
net use "%SRC_SHARE_ROOT%" /delete /y >nul 2>&1

if /I NOT "%SRC_SHARE_ROOT%"=="%DST_SHARE_ROOT%" (
    net use "%DST_SHARE_ROOT%" /delete /y >nul 2>&1
)

exit /b %RC%
"""
                            )

                            //
                            // Custom return code mapping.
                            //
                            if (rc == 101) {

                                writeFile(
                                    file: 'robocopy.error',
                                    text: 'Unable to connect to source SMB share.'
                                )

                                error(
                                    'Unable to connect to source SMB share.'
                                )
                            }

                            if (rc == 102) {

                                writeFile(
                                    file: 'robocopy.error',
                                    text: 'Unable to connect to destination SMB share.'
                                )

                                error(
                                    'Unable to connect to destination SMB share.'
                                )
                            }

                            if (rc == 103) {

                                writeFile(
                                    file: 'robocopy.error',
                                    text: 'Source path not accessible (missing path or permissions).'
                                )

                                error(
                                    'Source path not accessible.'
                                )
                            }

                            if (rc == 104) {

                                writeFile(
                                    file: 'robocopy.error',
                                    text: 'Destination path not accessible (missing path or permissions).'
                                )

                                error(
                                    'Destination path not accessible.'
                                )
                            }

                            //
                            // Robocopy semantics:
                            //
                            // RC 0-7 = Success / Informational
                            // RC 8+  = Failure
                            //
                            if (rc >= 8) {

                                writeFile(
                                    file: 'robocopy.error',
                                    text: "Robocopy failed with RC=${rc}"
                                )

                                error(
                                    "Robocopy failed with RC=${rc}"
                                )
                            }
                        }
                    }
                }
            }
        }
    }

    post {

        always {

            script {

                //
                // Calculate total execution duration in seconds.
                //
                long elapsed =
                    (System.currentTimeMillis() -
                    env.START_TIME.toLong()) / 1000

                //
                // Read user-friendly error message when available.
                //
                def errorMsg = ''

                if (fileExists('robocopy.error')) {

                    errorMsg =
                        readFile('robocopy.error').trim()
                }

                //
                // Read Robocopy return code captured by batch.
                //
                def rc = ''

                if (fileExists('robocopy.rc')) {

                    rc =
                        readFile('robocopy.rc').trim()
                }

                //
                // Parse Robocopy log.
                //
                // Only files reported as "New File"
                // are displayed in the final summary.
                //
                def copiedFiles = ''

                if (fileExists('robocopy.log')) {

                    copiedFiles =
                        readFile('robocopy.log')
                            .readLines()
                            .findAll {
                                it.contains('New File')
                            }
                            .collect {
                                it.replace('New File', '').trim()
                            }
                            .join('\n')
                }

                //
                // Final execution summary.
                //
                def summary = """SUMMARY

========================================

Job Name  : ${params.JOB_NAME}

Flags     : ${env.ROBOCOPY_OPTIONS}

File Mask : ${params.FILE_MASK}

Status    : ${errorMsg?.trim() ? errorMsg : "SUCCESS (RC=${rc})"}

Duration  : ${elapsed} seconds

Copied Files
----------------------------------------
${copiedFiles?.trim() ? copiedFiles : 'No files reported'}

========================================
"""

                echo(summary)
            }
        }
    }
}
