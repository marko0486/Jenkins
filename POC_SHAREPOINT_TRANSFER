import groovy.json.JsonSlurperClassic
import groovy.json.JsonOutput

// ============================================================================
// Helpers
// ============================================================================
def formatTime(long millis) {
    if (millis <= 0) return "—"
    return new Date(millis).format('yyyy-MM-dd HH:mm:ss')
}

def formatDuration(long millis) {
    if (millis <= 0) return "—"
    long totalSeconds = (millis / 1000).longValue()
    long minutes = totalSeconds / 60
    long seconds = totalSeconds % 60
    if (minutes > 0) return "${minutes} min ${seconds} sec"
    return "${seconds} sec"
}

@NonCPS
def prependHistoryAndTrim(List history, Map entry, int maxEntries) {
    def out = new ArrayList()
    out.add(entry)
    history.each { h ->
        if (out.size() >= maxEntries) return
        out.add(h)
    }
    return out
}

def stripTrailingSlash(String p) {
    if (!p) return ''
    def s = p.trim()
    if (s.toLowerCase().startsWith('http://') || s.toLowerCase().startsWith('https://')) {
        while (s.endsWith('/')) s = s.substring(0, s.length() - 1)
        return s
    }
    while (s.endsWith('\\') || s.endsWith('/')) {
        s = s.substring(0, s.length() - 1)
    }
    return s
}

pipeline {
    agent {
        label 'Windows'
    }

    parameters {
        string(name: 'JOB_NAME',        defaultValue: '')
        string(name: 'LOGICAL_JOB_NAME', defaultValue: '')
        string(name: 'SRC_PATH',        defaultValue: '')
        string(name: 'SITE_URL',        defaultValue: '')
        string(name: 'DST_URL',         defaultValue: '')
        string(name: 'DESTINATION',     defaultValue: '')
        string(name: 'LIBRARY',         defaultValue: 'Shared Documents')
        string(name: 'FILE_MASK',       defaultValue: '*.*')
        choice(name: 'OPERATION',       choices: ['COPY', 'MOVE'])
        booleanParam(name: 'OVERWRITE', defaultValue: true)
        string(name: 'SRC_CRED',        defaultValue: 'WIN.SVC.UC4.BATCHUSER')
        string(name: 'PARENT_BUILD',    defaultValue: 'N/A')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    stages {
        stage('SharePoint Transfer') {
            steps {
                script {
                    def startMillis = System.currentTimeMillis()
                    env.START_MILLIS = "${startMillis}"
                    env.START_TIME_STR = formatTime(startMillis)

                    def jobName = (params.JOB_NAME ?: params.LOGICAL_JOB_NAME ?: 'UNKNOWN_JOB').toString().trim()
                    if (!jobName) jobName = 'UNKNOWN_JOB'
                    env.LOGICAL_NAME = jobName

                    def srcPath = stripTrailingSlash(params.SRC_PATH ?: '')
                    def siteUrl = stripTrailingSlash(
                        (params.SITE_URL ?: params.DST_URL ?: params.DESTINATION ?: '').toString()
                    )
                    env.SRC_PATH_CLEAN = srcPath
                    env.SITE_URL_CLEAN = siteUrl

                    currentBuild.displayName = "#${env.BUILD_NUMBER} - ${jobName}"
                    currentBuild.description = "${params.FILE_MASK}"

                    def logDir = 'C:\\Jenkins\\Jobs\\Log'
                    def psFile = "${logDir}\\${jobName}_sharepoint-transfer_BuildID_${env.BUILD_NUMBER}.ps1"
                    def resultFile = "${logDir}\\${jobName}_result_BuildID_${env.BUILD_NUMBER}.txt"
                    def finalLogFile = "${logDir}\\${jobName}_BuildID_${env.BUILD_NUMBER}.txt"
                    env.PS_FILE = psFile
                    env.RESULT_FILE = resultFile
                    env.FINAL_LOG = finalLogFile
                    env.LOG_NAME = "${jobName}_BuildID_${env.BUILD_NUMBER}.txt"

                    // Defaults for post
                    env.SP_STATUS = 'FAILED'
                    env.SP_REASON = ''
                    env.SP_RC = '1'

                    bat """
@echo off
if not exist "${logDir}" mkdir "${logDir}"
"""

                    if (!srcPath) {
                        env.SP_STATUS = 'FAILED'
                        env.SP_REASON = 'SRC_PATH is empty'
                        error(env.SP_REASON)
                    }
                    if (!siteUrl) {
                        env.SP_STATUS = 'FAILED'
                        env.SP_REASON = 'SITE_URL is empty'
                        error(env.SP_REASON)
                    }

                    withCredentials([
                        usernamePassword(
                            credentialsId: params.SRC_CRED,
                            usernameVariable: 'FT_USER',
                            passwordVariable: 'FT_PASS'
                        )
                    ]) {
                        bat """
@echo off
echo Authenticating to UNC path using credential: ${params.SRC_CRED}
net use "${srcPath}" %FT_PASS% /user:%FT_USER% >nul 2>&1
if errorlevel 1 (
    echo WARNING: net use failed on full path. Trying share root...
    for /f "tokens=1,2,3 delims=\\" %%a in ("${srcPath}") do (
        net use "\\\\%%b\\%%c" %FT_PASS% /user:%FT_USER% >nul 2>&1
    )
)
exit /b 0
"""

                        try {
                            writeFile(
                                file: psFile,
                                text: """
# ================================================================
# SharePoint Transfer Script - Build ${env.BUILD_NUMBER}
# Exit codes: 0=SUCCESS, 2=UNSTABLE (no files), 1=FAILED
# ================================================================
\$clientId   = "c9864df8-7369-42e5-bec4-2a7fd1e6cf7a"
\$tenantId   = "eb70b763-b6d7-4486-8555-8831709a784e"
\$thumbPrint = "30da72f8c36269bdcc7e8aefcc577c0ef51eef90"
\$ErrorActionPreference = "Stop"
\$siteUrl   = \$env:SITE_URL
\$source    = \$env:SRC_PATH
\$mask      = \$env:FILE_MASK
\$library   = \$env:LIBRARY
\$operation = \$env:OPERATION
\$overwrite = [System.Convert]::ToBoolean(\$env:OVERWRITE)
\$connected = \$false
\$uploaded  = @()
\$skipped   = @()
\$errorMsg  = ""
\$exitCode  = 0
\$resultFile = "${resultFile}"

try {
    if (-not (Test-Path -LiteralPath \$source)) {
        throw "ACCESS_OR_MISSING: Source path does not exist or access denied: \$source"
    }
    Connect-PnPOnline -Url \$siteUrl -ClientId \$clientId -Tenant \$tenantId -Thumbprint \$thumbPrint -ErrorAction Stop
    \$connected = \$true
    Get-PnPWeb -ErrorAction Stop | Out-Null

    \$files = @(Get-ChildItem -LiteralPath \$source -Filter \$mask -File -ErrorAction Stop)
    if (\$files.Count -eq 0) {
        \$errorMsg = "NO_FILES: No files found matching: \$mask"
        \$exitCode = 2
    } else {
        foreach (\$file in \$files) {
            Write-Host ""
            Write-Host "Uploading: \$(\$file.Name)"
            Write-Host "Operation: \$operation"
            if (\$overwrite) {
                Add-PnPFile -Path \$file.FullName -Folder \$library -ErrorAction Stop
            } else {
                \$existingFile = Get-PnPFile -Url "\$library/\$(\$file.Name)" -AsListItem -ErrorAction SilentlyContinue
                if (\$existingFile) {
                    \$skipped += \$file.Name
                    Write-Host "Skipped (already exists): \$(\$file.Name)"
                    continue
                }
                Add-PnPFile -Path \$file.FullName -Folder \$library -ErrorAction Stop
            }
            \$uploaded += \$file.Name
            if (\$operation -eq 'MOVE') {
                Remove-Item -LiteralPath \$file.FullName -Force -ErrorAction Stop
            }
        }
    }
}
catch {
    \$errorMsg = \$_.Exception.Message
    if (\$exitCode -eq 0) { \$exitCode = 1 }
}
finally {
    if (\$connected) {
        Disconnect-PnPOnline -ErrorAction SilentlyContinue
    }
    \$content = @"
UPLOADED
\$(\$uploaded -join "`n")
---
SKIPPED
\$(\$skipped -join "`n")
---
ERROR
\$errorMsg
---
EXIT
\$exitCode
"@
    \$content | Set-Content -Path \$resultFile -Encoding UTF8
}
exit \$exitCode
"""
                            )

                            withEnv([
                                "SITE_URL=${siteUrl}",
                                "SRC_PATH=${srcPath}",
                                "FILE_MASK=${params.FILE_MASK}",
                                "LIBRARY=${params.LIBRARY}",
                                "OPERATION=${params.OPERATION}",
                                "OVERWRITE=${params.OVERWRITE}"
                            ]) {
                                def rc = bat(
                                    returnStatus: true,
                                    script: """
@echo off
"C:\\Program Files\\PowerShell\\7\\pwsh.exe" ^
    -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass ^
    -File "${psFile}"
exit /b %ERRORLEVEL%
"""
                                )
                                env.SP_RC = "${rc}"

                                // Read result early for classification
                                def errorMsg = ''
                                def uploadedList = []
                                def skippedList = []
                                if (fileExists(resultFile)) {
                                    def content = readFile(resultFile)
                                    def parts = content.split('---')
                                    if (parts.size() >= 1) {
                                        def u = parts[0].replace('UPLOADED', '').trim()
                                        if (u) uploadedList = u.split('\n').findAll { it.trim() }
                                    }
                                    if (parts.size() >= 2) {
                                        def s = parts[1].replace('SKIPPED', '').trim()
                                        if (s) skippedList = s.split('\n').findAll { it.trim() }
                                    }
                                    if (parts.size() >= 3) {
                                        errorMsg = parts[2].replace('ERROR', '').trim()
                                    }
                                }
                                env.SP_REASON = errorMsg ?: ''

                                if (rc == 2 || (errorMsg && errorMsg.toUpperCase().startsWith('NO_FILES'))) {
                                    // Path OK, mask matched nothing
                                    env.SP_STATUS = 'UNSTABLE'
                                    env.SP_REASON = errorMsg ?: "No files found matching: ${params.FILE_MASK}"
                                    unstable(env.SP_REASON)
                                } else if (rc != 0) {
                                    env.SP_STATUS = 'FAILED'
                                    if (!env.SP_REASON) {
                                        env.SP_REASON = "SharePoint transfer failed. RC=${rc}"
                                    }
                                    // Access denied / missing path / API errors
                                    error(env.SP_REASON)
                                } else if (uploadedList.isEmpty() && !skippedList.isEmpty()) {
                                    env.SP_STATUS = 'SUCCESS'
                                    env.SP_REASON = ''
                                } else if (uploadedList.isEmpty()) {
                                    env.SP_STATUS = 'UNSTABLE'
                                    env.SP_REASON = 'No files processed'
                                    unstable(env.SP_REASON)
                                } else {
                                    env.SP_STATUS = 'SUCCESS'
                                    env.SP_REASON = ''
                                }
                            }
                        } finally {
                            bat """
@echo off
net use "${srcPath}" /delete /y >nul 2>&1
for /f "tokens=1,2,3 delims=\\" %%a in ("${srcPath}") do (
    net use "\\\\%%b\\%%c" /delete /y >nul 2>&1
)
exit /b 0
"""
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def startMillis = (env.START_MILLIS ?: '0').toLong()
                def endMillis = System.currentTimeMillis()
                def startTime = env.START_TIME_STR ?: formatTime(startMillis)
                def endTime = formatTime(endMillis)
                def duration = formatDuration(endMillis - startMillis)
                def elapsedSec = ((endMillis - startMillis) / 1000).longValue()

                def jobName = (env.LOGICAL_NAME ?: params.JOB_NAME ?: params.LOGICAL_JOB_NAME ?: 'UNKNOWN_JOB').toString()
                def logDir = 'C:\\Jenkins\\Jobs\\Log'
                def resultFile = env.RESULT_FILE ?: "${logDir}\\${jobName}_result_BuildID_${env.BUILD_NUMBER}.txt"
                def finalLogFile = env.FINAL_LOG ?: "${logDir}\\${jobName}_BuildID_${env.BUILD_NUMBER}.txt"
                def logName = env.LOG_NAME ?: "${jobName}_BuildID_${env.BUILD_NUMBER}.txt"

                def uploadedList = []
                def skippedList = []
                def errorMsg = (env.SP_REASON ?: '').toString()

                if (fileExists(resultFile)) {
                    def content = readFile(resultFile)
                    def parts = content.split('---')
                    if (parts.size() >= 1) {
                        def u = parts[0].replace('UPLOADED', '').trim()
                        if (u) uploadedList = u.split('\n').findAll { it.trim() }
                    }
                    if (parts.size() >= 2) {
                        def s = parts[1].replace('SKIPPED', '').trim()
                        if (s) skippedList = s.split('\n').findAll { it.trim() }
                    }
                    if (parts.size() >= 3) {
                        def e = parts[2].replace('ERROR', '').trim()
                        if (e) errorMsg = e
                    }
                }

                def status = (env.SP_STATUS ?: 'FAILED').toString().toUpperCase()
                // Safety net from Jenkins result
                if (status != 'SUCCESS' && status != 'UNSTABLE' && status != 'FAILED') {
                    status = 'FAILED'
                }
                if (currentBuild.currentResult == 'FAILURE' && status == 'SUCCESS') {
                    status = 'FAILED'
                }
                if (currentBuild.currentResult == 'UNSTABLE' && status == 'SUCCESS') {
                    status = 'UNSTABLE'
                }

                def failReason = null
                if (status != 'SUCCESS') {
                    failReason = errorMsg ?: status
                }

                def finalStatusText
                if (status == 'SUCCESS') {
                    finalStatusText = "SUCCESS (${params.OPERATION})"
                } else if (status == 'UNSTABLE') {
                    finalStatusText = "UNSTABLE: ${failReason}"
                } else {
                    finalStatusText = "FAILED: ${failReason}"
                }

                def uploadedSection = uploadedList ? uploadedList.indexed().collect { i, f -> "${i + 1}. ${f}" }.join('\n') + '\n' : "No files uploaded\n"
                def skippedSection = skippedList ? skippedList.indexed().collect { i, f -> "${i + 1}. ${f}" }.join('\n') + '\n' : "No files skipped\n"

                def timestamp = new Date().format('yyyy-MM-dd HH:mm:ss')
                def buildParent = "${params.PARENT_BUILD}"

                def logContent = """SUMMARY
========================================
Job Name     : ${jobName}
Site URL     : ${env.SITE_URL_CLEAN ?: params.SITE_URL}
Source       : ${env.SRC_PATH_CLEAN ?: params.SRC_PATH}
Library      : ${params.LIBRARY}
Operation    : ${params.OPERATION}
File Mask    : ${params.FILE_MASK}
SRC_CRED     : ${params.SRC_CRED}
Status       : ${finalStatusText}
Duration     : ${elapsedSec} seconds
Timestamp    : ${timestamp}
Build Parent : ${buildParent}
Uploaded Files (${uploadedList.size()})
----------------------------------------
${uploadedSection}
Skipped Files (${skippedList.size()})
----------------------------------------
${skippedSection}
Errors
----------------------------------------
${errorMsg ? errorMsg : 'None'}
========================================
"""
                writeFile file: finalLogFile, text: logContent
                echo(logContent)

                // ============================================================
                // Dashboard history.json  →  Last Run / Last Status
                // ============================================================
                def histDir  = "C:\\Jenkins\\Jobs\\Dashboard\\data\\scheduled\\${jobName}"
                def histFile = "${histDir}\\history.json"
                def histWork = "${env.WORKSPACE}\\history_temp_${env.BUILD_NUMBER}.json"

                bat """
@echo off
if not exist "${histDir}" mkdir "${histDir}"
if exist "${histFile}" (
    copy /Y "${histFile}" "${histWork}" >nul
) else (
    echo []> "${histWork}"
)
"""

                def history = []
                try {
                    def raw = readFile(file: histWork).trim()
                    if (raw && raw != '[]') {
                        def parsed = new JsonSlurperClassic().parseText(raw)
                        if (parsed instanceof List) history = new ArrayList(parsed)
                    }
                } catch (Exception e) {
                    echo "WARNING: could not parse history: ${e.message}"
                    history = []
                }

                def entry = [
                    build     : env.BUILD_NUMBER.toInteger(),
                    startTime : startTime,
                    endTime   : endTime,
                    duration  : duration,
                    status    : status,
                    logFile   : logName,
                    reason    : failReason
                ]
                history = prependHistoryAndTrim(history, entry, 20)
                writeFile file: histWork, text: JsonOutput.prettyPrint(JsonOutput.toJson(history))
                bat """
@echo off
copy /Y "${histWork}" "${histFile}" >nul
"""
                echo "Scheduled history updated: ${histFile}"
                echo "Final status for Dashboard: ${status}"

                bat """
@echo off
if exist "${env.PS_FILE}" del /f /q "${env.PS_FILE}"
if exist "${resultFile}" del /f /q "${resultFile}"
"""
            }
        }
    }
}
