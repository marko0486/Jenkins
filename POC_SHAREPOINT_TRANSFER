pipeline {
    agent {
        label 'Windows'
    }

    parameters {
        string(name: 'JOB_NAME',    defaultValue: '')
        string(name: 'SRC_PATH',    defaultValue: '')
        string(name: 'SITE_URL',    defaultValue: '')
        string(name: 'LIBRARY',     defaultValue: 'Shared Documents')
        string(name: 'FILE_MASK',   defaultValue: '*.*')
        choice(
            name: 'OPERATION',
            choices: ['COPY', 'MOVE']
        )
        booleanParam(
            name: 'OVERWRITE',
            defaultValue: true
        )
        // Credential used to authenticate against the UNC source path
        string(
            name: 'SRC_CRED',
            defaultValue: 'WIN.SVC.UC4.BATCHUSER'
        )
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    stages {
        stage('SharePoint Transfer') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    script {
                        def startTime = System.currentTimeMillis()
                        env.START_TIME = "${startTime}"

                        currentBuild.displayName = "#${env.BUILD_NUMBER} - ${params.JOB_NAME}"
                        currentBuild.description = "${params.FILE_MASK}"

                        // ============================================================
                        // LOG DIRECTORY AND FILE NAMES
                        // ============================================================
                        def logDir = "C:\\Jenkins\\Jobs\\Log"
                        def jenkinsJobName = currentBuild.rawBuild.getParent().getName()

                        def psFile        = "${logDir}\\${jenkinsJobName}_sharepoint-transfer_BuildID_${env.BUILD_NUMBER}.ps1"
                        def resultFile    = "${logDir}\\${jenkinsJobName}_result_BuildID_${env.BUILD_NUMBER}.txt"
                        def finalLogFile  = "${logDir}\\${jenkinsJobName}_BuildID_${env.BUILD_NUMBER}.txt"

                        env.PS_FILE     = psFile
                        env.RESULT_FILE = resultFile
                        env.FINAL_LOG   = finalLogFile

                        // Ensure log directory exists
                        bat """
@echo off
if not exist "${logDir}" mkdir "${logDir}"
"""

                        // ============================================================
                        // UNC AUTHENTICATION
                        // ============================================================
                        withCredentials([
                            usernamePassword(
                                credentialsId: params.SRC_CRED,
                                usernameVariable: 'FT_USER',
                                passwordVariable: 'FT_PASS'
                            )
                        ]) {
                            bat """
@echo off
echo Authenticating to UNC path using credential: ${params.SRC_CRED}
net use "${params.SRC_PATH}" %FT_PASS% /user:%FT_USER% >nul 2>&1
if errorlevel 1 (
    echo WARNING: net use failed on full path. Trying share root...
    for /f "tokens=1,2,3 delims=\\" %%a in ("${params.SRC_PATH}") do (
        net use "\\\\%%b\\%%c" %FT_PASS% /user:%FT_USER% >nul 2>&1
    )
)
exit /b 0
"""

                            try {
                                // ============================================================
                                // GENERATE POWERSHELL SCRIPT
                                // ============================================================
                                writeFile(
                                    file: psFile,
                                    text: """
# ================================================================
# SharePoint Transfer Script
# Generated by Jenkins Pipeline - Build ${env.BUILD_NUMBER}
# ================================================================
\$clientId   = "c9864df8-7369-42e5-bec4-2a7fd1e6cf7a"
\$tenantId   = "eb70b763-b6d7-4486-8555-8831709a784e"
\$thumbPrint = "30da72f8c36269bdcc7e8aefcc577c0ef51eef90"
\$ErrorActionPreference = "Stop"

\$siteUrl   = \$env:SITE_URL
\$source    = \$env:SRC_PATH
\$mask      = \$env:FILE_MASK
\$library   = \$env:LIBRARY
\$operation = \$env:OPERATION
\$overwrite = [System.Convert]::ToBoolean(\$env:OVERWRITE)

\$connected = \$false
\$uploaded  = @()
\$skipped   = @()
\$errorMsg  = ""

\$resultFile = "${resultFile}"

try {
    if (-not (Test-Path \$source)) {
        throw "Source path does not exist or is not accessible: \$source"
    }

    Connect-PnPOnline `
        -Url \$siteUrl `
        -ClientId \$clientId `
        -Tenant \$tenantId `
        -Thumbprint \$thumbPrint `
        -ErrorAction Stop
    \$connected = \$true

    Get-PnPWeb -ErrorAction Stop | Out-Null

    \$files = @(Get-ChildItem -Path \$source -Filter \$mask -File)

    if (\$files.Count -eq 0) {
        throw "No files found matching: \$mask"
    }

    foreach (\$file in \$files) {
        Write-Host ""
        Write-Host "Uploading: \$(\$file.Name)"
        Write-Host "Operation: \$operation"

        if (\$overwrite) {
            Add-PnPFile -Path \$file.FullName -Folder \$library -ErrorAction Stop
        }
        else {
            \$existingFile = Get-PnPFile -Url "\$library/\$(\$file.Name)" -AsListItem -ErrorAction SilentlyContinue
            if (\$existingFile) {
                \$skipped += \$file.Name
                Write-Host "Skipped (already exists): \$(\$file.Name)"
                continue
            }
            Add-PnPFile -Path \$file.FullName -Folder \$library -ErrorAction Stop
        }

        \$uploaded += \$file.Name

        if (\$operation -eq 'MOVE') {
            Remove-Item -Path \$file.FullName -Force -ErrorAction Stop
        }
    }
}
catch {
    \$errorMsg = \$_.Exception.Message
    exit 1
}
finally {
    if (\$connected) {
        Disconnect-PnPOnline -ErrorAction SilentlyContinue
    }

    \$content = @"
UPLOADED
\$(\$uploaded -join "`n")
---
SKIPPED
\$(\$skipped -join "`n")
---
ERROR
\$errorMsg
"@
    \$content | Set-Content -Path \$resultFile -Encoding UTF8
}
exit 0
"""
                                )

                                // ============================================================
                                // EXECUTE POWERSHELL SCRIPT
                                // ============================================================
                                withEnv([
                                    "SITE_URL=${params.SITE_URL}",
                                    "SRC_PATH=${params.SRC_PATH}",
                                    "FILE_MASK=${params.FILE_MASK}",
                                    "LIBRARY=${params.LIBRARY}",
                                    "OPERATION=${params.OPERATION}",
                                    "OVERWRITE=${params.OVERWRITE}"
                                ]) {
                                    def rc = bat(
                                        returnStatus: true,
                                        script: """
@echo off
"C:\\Program Files\\PowerShell\\7\\pwsh.exe" ^
    -NoLogo ^
    -NoProfile ^
    -NonInteractive ^
    -ExecutionPolicy Bypass ^
    -File "${psFile}"
exit /b %ERRORLEVEL%
"""
                                    )
                                    if (rc != 0) {
                                        error("SharePoint transfer failed. RC=${rc}")
                                    }
                                }
                            }
                            finally {
                                // Always disconnect the UNC mapping
                                bat """
@echo off
net use "${params.SRC_PATH}" /delete /y >nul 2>&1
for /f "tokens=1,2,3 delims=\\" %%a in ("${params.SRC_PATH}") do (
    net use "\\\\%%b\\%%c" /delete /y >nul 2>&1
)
exit /b 0
"""
                            }
                        } // end withCredentials
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                long elapsed = (System.currentTimeMillis() - env.START_TIME.toLong()) / 1000

                def logDir         = "C:\\Jenkins\\Jobs\\Log"
                def jenkinsJobName = currentBuild.rawBuild.getParent().getName()
                def resultFile     = "${logDir}\\${jenkinsJobName}_result_BuildID_${env.BUILD_NUMBER}.txt"
                def finalLogFile   = "${logDir}\\${jenkinsJobName}_BuildID_${env.BUILD_NUMBER}.txt"

                def uploadedList = []
                def skippedList  = []
                def errorMsg     = ''

                // --------------------------------------------------------
                // Parse the temporary result file
                // --------------------------------------------------------
                if (fileExists(resultFile)) {
                    def content = readFile(resultFile)
                    def parts = content.split('---')

                    if (parts.size() >= 1) {
                        def uploadedSection = parts[0].replace('UPLOADED', '').trim()
                        if (uploadedSection) {
                            uploadedList = uploadedSection.split('\n').findAll { it.trim() }
                        }
                    }
                    if (parts.size() >= 2) {
                        def skippedSection = parts[1].replace('SKIPPED', '').trim()
                        if (skippedSection) {
                            skippedList = skippedSection.split('\n').findAll { it.trim() }
                        }
                    }
                    if (parts.size() >= 3) {
                        errorMsg = parts[2].replace('ERROR', '').trim()
                    }
                }

                // --------------------------------------------------------
                // Determine final status
                // --------------------------------------------------------
                def finalStatus = ''
                if (errorMsg) {
                    finalStatus = errorMsg
                } else if (uploadedList.isEmpty() && skippedList.isEmpty()) {
                    finalStatus = 'NO FILES PROCESSED'
                } else if (uploadedList.isEmpty() && !skippedList.isEmpty()) {
                    finalStatus = 'NO FILES PROCESSED (all skipped)'
                } else {
                    finalStatus = "SUCCESS (${params.OPERATION})"
                }

                // --------------------------------------------------------
                // Build numbered lists
                // --------------------------------------------------------
                def uploadedSection = ""
                if (uploadedList) {
                    uploadedList.eachWithIndex { file, idx ->
                        uploadedSection += "${idx + 1}. ${file}\n"
                    }
                } else {
                    uploadedSection = "No files uploaded\n"
                }

                def skippedSection = ""
                if (skippedList) {
                    skippedList.eachWithIndex { file, idx ->
                        skippedSection += "${idx + 1}. ${file}\n"
                    }
                } else {
                    skippedSection = "No files skipped\n"
                }

                // --------------------------------------------------------
                // Timestamp
                // --------------------------------------------------------
                def timestamp = new Date().format('yyyy-MM-dd HH:mm:ss')

                // --------------------------------------------------------
                // Build Parent - Robust & Clean Version
                // --------------------------------------------------------
                def buildParent = "N/A"
                try {
                    // 1. Check Upstream Cause directly using Jenkins API
                    def upstreamCause = currentBuild.rawBuild.getCause(hudson.model.Cause$UpstreamCause)
                    if (upstreamCause != null) {
                        buildParent = "${upstreamCause.getUpstreamProject()} #${upstreamCause.getUpstreamBuild()}"
                    } 
                    
                    // 2. Search upstream in buildCauses structure
                    if (buildParent == "N/A" && currentBuild.buildCauses) {
                        for (cause in currentBuild.buildCauses) {
                            if (cause._class?.contains("UpstreamCause") && cause.upstreamProject) {
                                buildParent = "${cause.upstreamProject} #${cause.upstreamBuild}"
                                break
                            }
                        }
                    }

                    // 3. Check for User/Manual trigger if not triggered by Upstream
                    if (buildParent == "N/A") {
                        def userCause = currentBuild.rawBuild.getCause(hudson.model.Cause$UserIdCause)
                        if (userCause != null) {
                            buildParent = "Manual execution by ${userCause.getUserName()}"
                        }
                    }
                } catch (Exception e) {
                    echo "Warning: Could not determine Build Parent: ${e.message}"
                    buildParent = "N/A"
                }

                // --------------------------------------------------------
                // Build the single final log content
                // --------------------------------------------------------
                def logContent = """SUMMARY
========================================
Job Name     : ${params.JOB_NAME}
Site URL     : ${params.SITE_URL}
Library      : ${params.LIBRARY}
Operation    : ${params.OPERATION}
File Mask    : ${params.FILE_MASK}
SRC_CRED     : ${params.SRC_CRED}
Status       : ${finalStatus}
Duration     : ${elapsed} seconds
Timestamp    : ${timestamp}
Build Parent : ${buildParent}

Uploaded Files (${uploadedList.size()})
----------------------------------------
${uploadedSection}
Skipped Files (${skippedList.size()})
----------------------------------------
${skippedSection}
Errors
----------------------------------------
${errorMsg ? errorMsg : 'None'}
========================================
"""

                // Write the single final log file
                writeFile file: finalLogFile, text: logContent

                // Also show the summary in the Jenkins console
                echo(logContent)

                // --------------------------------------------------------
                // CLEANUP
                // --------------------------------------------------------
                bat """
@echo off
if exist "${env.PS_FILE}" del /f /q "${env.PS_FILE}"
if exist "${resultFile}" del /f /q "${resultFile}"
"""
            }
        }
    }
}
