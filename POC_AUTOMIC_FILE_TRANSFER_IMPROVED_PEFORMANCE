pipeline {
    // ========================================================================
    // Agent: cualquier nodo Windows con capacidad de SMB + Robocopy
    // ========================================================================
    agent {
        label 'Windows'
    }

    // ========================================================================
    // Parameters (enviados por el Orchestrator)
    // ========================================================================
    parameters {
        string(name: 'JOB_NAME',        defaultValue: '', description: 'Logical transfer name from JSON')
        string(name: 'SRC_CRED',        defaultValue: '', description: 'Jenkins credential ID for SMB')
        string(name: 'SRC_PATH',        defaultValue: '', description: 'Full UNC source path')
        string(name: 'DST_PATH',        defaultValue: '', description: 'Full UNC destination path')
        string(name: 'FILE_MASK',       defaultValue: '*.*', description: 'Robocopy file mask')
        string(name: 'ROBOCOPY_FLAGS',  defaultValue: '', description: 'Additional Robocopy flags')
        string(name: 'PARENT_BUILD',    defaultValue: '', description: 'Build number of the parent Orchestrator job')
    }

    // ========================================================================
    // Options
    // ========================================================================
    options {
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    // ========================================================================
    // Environment
    // ========================================================================
    environment {
        START_TIME = "${System.currentTimeMillis()}"
    }

    stages {
        stage('Transfer Definition') {
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    script {
                        // ----------------------------------------------------
                        // Jenkins UI
                        // ----------------------------------------------------
                        currentBuild.displayName = "#${env.BUILD_NUMBER} - ${params.JOB_NAME}"
                        currentBuild.description = "${params.FILE_MASK} : ${params.SRC_PATH} → ${params.DST_PATH}"

                        // ----------------------------------------------------
                        // Resolve credential
                        // ----------------------------------------------------
                        def creds = com.cloudbees.plugins.credentials.CredentialsProvider.lookupCredentials(
                            com.cloudbees.plugins.credentials.common.StandardUsernamePasswordCredentials.class,
                            jenkins.model.Jenkins.get(),
                            null,
                            null
                        )

                        def cred = creds.find { it.id == params.SRC_CRED }

                        env.FT_USERNAME   = cred ? cred.username : "UNKNOWN"
                        env.CREDENTIAL_ID = cred ? cred.id : ""

                        if (!env.CREDENTIAL_ID?.trim()) {
                            writeFile file: 'robocopy.error', text: "Credential not found for ID: ${params.SRC_CRED}"
                            unstable("Credential not found for ID: ${params.SRC_CRED}")
                            return
                        }

                        // ----------------------------------------------------
                        // Normalize flags
                        // ----------------------------------------------------
                        env.ROBOCOPY_OPTIONS = params.ROBOCOPY_FLAGS?.trim() ?: ""

                        // ----------------------------------------------------
                        // Parse UNC paths → share roots
                        // ----------------------------------------------------
                        def srcParts = params.SRC_PATH.replaceFirst('^\\\\\\\\', '').split('\\\\')
                        if (srcParts.size() < 2) {
                            writeFile file: 'robocopy.error', text: 'Invalid source UNC path.'
                            unstable('Invalid source UNC path.')
                            return
                        }
                        env.SRC_SHARE_ROOT = "\\\\${srcParts[0]}\\${srcParts[1]}"

                        def dstParts = params.DST_PATH.replaceFirst('^\\\\\\\\', '').split('\\\\')
                        if (dstParts.size() < 2) {
                            writeFile file: 'robocopy.error', text: 'Invalid destination UNC path.'
                            unstable('Invalid destination UNC path.')
                            return
                        }
                        env.DST_SHARE_ROOT = "\\\\${dstParts[0]}\\${dstParts[1]}"

                        // Same share? → only map once (performance)
                        env.SAME_SHARE = (env.SRC_SHARE_ROOT.equalsIgnoreCase(env.DST_SHARE_ROOT)) ? "YES" : "NO"

                        // ----------------------------------------------------
                        // Console header
                        // ----------------------------------------------------
                        echo "========================================"
                        echo "Job Name      : ${params.JOB_NAME}"
                        echo "User          : ${env.FT_USERNAME}"
                        echo "Credential ID : ${params.SRC_CRED}"
                        echo "Source        : ${params.SRC_PATH}"
                        echo "Destination   : ${params.DST_PATH}"
                        echo "Source Share  : ${env.SRC_SHARE_ROOT}"
                        echo "Dest Share    : ${env.DST_SHARE_ROOT}"
                        echo "Same Share    : ${env.SAME_SHARE}"
                        echo "File Mask     : ${params.FILE_MASK}"
                        echo "Robocopy Flags: ${env.ROBOCOPY_OPTIONS}"
                        echo "Parent Build  : #${params.PARENT_BUILD}"
                        echo "========================================"

                        // ----------------------------------------------------
                        // Execute transfer
                        // ----------------------------------------------------
                        withCredentials([
                            usernamePassword(
                                credentialsId: env.CREDENTIAL_ID,
                                usernameVariable: 'FT_USER',
                                passwordVariable: 'FT_PASS'
                            )
                        ]) {
                            def rc = bat(
                                returnStatus: true,
                                script: """
@echo off
setlocal EnableDelayedExpansion

if exist robocopy.error del robocopy.error
if exist robocopy.rc    del robocopy.rc
if exist robocopy.log   del robocopy.log

echo [INFO] Cleaning previous connections...
net use "%SRC_SHARE_ROOT%" /delete /y >nul 2>&1
if /I NOT "%SAME_SHARE%"=="YES" (
    net use "%DST_SHARE_ROOT%" /delete /y >nul 2>&1
)

echo [INFO] Authenticating SOURCE share: %SRC_SHARE_ROOT%
net use "%SRC_SHARE_ROOT%" "%FT_PASS%" /user:"%FT_USER%" /persistent:no >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Failed to authenticate SOURCE share
    exit /b 101
)

if /I "%SAME_SHARE%"=="YES" (
    echo [INFO] Source and Destination are on the SAME share - reusing connection
) else (
    echo [INFO] Authenticating DESTINATION share: %DST_SHARE_ROOT%
    net use "%DST_SHARE_ROOT%" "%FT_PASS%" /user:"%FT_USER%" /persistent:no >nul 2>&1
    if errorlevel 1 (
        echo [ERROR] Failed to authenticate DESTINATION share
        net use "%SRC_SHARE_ROOT%" /delete /y >nul 2>&1
        exit /b 102
    )
)

echo [INFO] Validating SOURCE path accessibility...
dir "${params.SRC_PATH}" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] SOURCE path not accessible
    net use "%SRC_SHARE_ROOT%" /delete /y >nul 2>&1
    if /I NOT "%SAME_SHARE%"=="YES" net use "%DST_SHARE_ROOT%" /delete /y >nul 2>&1
    exit /b 103
)

echo [INFO] Validating DESTINATION path accessibility...
dir "${params.DST_PATH}" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] DESTINATION path not accessible
    net use "%SRC_SHARE_ROOT%" /delete /y >nul 2>&1
    if /I NOT "%SAME_SHARE%"=="YES" net use "%DST_SHARE_ROOT%" /delete /y >nul 2>&1
    exit /b 104
)

echo [INFO] Starting Robocopy...
robocopy "${params.SRC_PATH}" "${params.DST_PATH}" "${params.FILE_MASK}" ${env.ROBOCOPY_OPTIONS} > robocopy.log
set RC=!ERRORLEVEL!
echo !RC! > robocopy.rc

echo [INFO] Cleaning up connections...
net use "%SRC_SHARE_ROOT%" /delete /y >nul 2>&1
if /I NOT "%SAME_SHARE%"=="YES" (
    net use "%DST_SHARE_ROOT%" /delete /y >nul 2>&1
)

echo [INFO] Robocopy finished with RC=!RC!
exit /b !RC!
"""
                            )

                            // ------------------------------------------------
                            // Return code handling
                            // ------------------------------------------------
                            if (rc == 101) {
                                writeFile file: 'robocopy.error', text: 'Unable to connect to SOURCE SMB share. Check credentials and permissions.'
                                error('Unable to connect to SOURCE SMB share.')
                            }
                            if (rc == 102) {
                                writeFile file: 'robocopy.error', text: 'Unable to connect to DESTINATION SMB share. Check credentials and permissions.'
                                error('Unable to connect to DESTINATION SMB share.')
                            }
                            if (rc == 103) {
                                writeFile file: 'robocopy.error', text: 'SOURCE path not accessible (missing path or insufficient permissions).'
                                error('SOURCE path not accessible.')
                            }
                            if (rc == 104) {
                                writeFile file: 'robocopy.error', text: 'DESTINATION path not accessible (missing path or insufficient permissions).'
                                error('DESTINATION path not accessible.')
                            }
                            // Robocopy: 0-7 = success/info, >=8 = failure
                            if (rc >= 8) {
                                writeFile file: 'robocopy.error', text: "Robocopy failed with RC=${rc}. Most common cause: Access Denied (ERROR 5) - the account has no Read permission on source files or no Write permission on destination."
                                error("Robocopy failed with RC=${rc}")
                            }
                        }
                    }
                }
            }
        }
    }

    // ========================================================================
    // Post – always write the detailed log
    // ========================================================================
    post {
        always {
            script {
                long elapsed = (System.currentTimeMillis() - env.START_TIME.toLong()) / 1000

                def errorMsg = fileExists('robocopy.error') ? readFile('robocopy.error').trim() : ''
                def rc       = fileExists('robocopy.rc')    ? readFile('robocopy.rc').trim()    : ''
                def fullLog  = fileExists('robocopy.log')   ? readFile('robocopy.log')          : 'No Robocopy log generated.'

                def logContent = """SUMMARY
================================================================================
Job Name     : ${params.JOB_NAME}
File Mask    : ${params.FILE_MASK}
SRC_CRED     : ${params.SRC_CRED}
Duration     : ${elapsed} seconds
Timestamp    : ${new Date().format('yyyy-MM-dd HH:mm:ss')}
Build Parent : #${params.PARENT_BUILD}
-------------------------------------------------------------------------------
${fullLog}
================================================================================
END OF LOG
"""

                // Log name = JOB_NAME del JSON + BuildID del job actual
                def logDir  = 'C:\\Jenkins\\Jobs\\Log'
                def logName = "${params.JOB_NAME}_BuildID_${env.BUILD_NUMBER}.txt"
                def logPath = "${logDir}\\${logName}"

                bat """
@echo off
if not exist "${logDir}" mkdir "${logDir}"
"""

                writeFile file: logPath, text: logContent
                echo "Detailed Robocopy log written to: ${logPath}"

                echo """
SUMMARY
================================================================================
Job Name  : ${params.JOB_NAME}
Flags     : ${env.ROBOCOPY_OPTIONS}
File Mask : ${params.FILE_MASK}
Status    : ${errorMsg ? errorMsg : "SUCCESS (RC=${rc})"}
Duration  : ${elapsed} seconds
================================================================================
"""
            }
        }
    }
}
