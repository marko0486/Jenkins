import groovy.json.JsonSlurperClassic
import groovy.json.JsonOutput

// ============================================================================
// GLOBAL EXECUTION COUNTERS AND LISTS
// ============================================================================
def TOTAL          = 0
def DISABLED       = 0
def CHECKED        = 0
def EXECUTED       = 0
def SKIPPED        = 0
def FAILURES       = []
def DISABLED_JOBS  = []
def SKIPPED_JOBS   = []
def SUCCESS_JOBS   = []
def CHILDREN       = []

// ============================================================================
// Helpers @NonCPS
// ============================================================================
@NonCPS
def sortIndexDesc(List data) {
    data.sort { a, b ->
        def ba = (a.build instanceof Number) ? a.build.intValue() : a.build.toString().toInteger()
        def bb = (b.build instanceof Number) ? b.build.intValue() : b.build.toString().toInteger()
        return bb <=> ba
    }
    return data
}

@NonCPS
def filterOutBuild(List data, int buildNum) {
    return data.findAll { entry ->
        try {
            def b = entry.build
            def bi = (b instanceof Number) ? b.intValue() : b.toString().toInteger()
            return bi != buildNum
        } catch (Exception ignored) {
            return true
        }
    }
}

// ============================================================================
// Time helpers
// ============================================================================
def formatTime(long millis) {
    if (millis <= 0) return "—"
    return new Date(millis).format('yyyy-MM-dd HH:mm:ss')
}

def formatDuration(long millis) {
    if (millis <= 0) return "—"
    long totalSeconds = (millis / 1000).longValue()
    long minutes = totalSeconds / 60
    long seconds = totalSeconds % 60
    if (minutes > 0) {
        return "${minutes} min ${seconds} sec"
    }
    return "${seconds} sec"
}

pipeline {
    agent {
        label 'built-in'
    }
    options {
        disableConcurrentBuilds()
    }
    stages {
        stage('File Transfers') {
            steps {
                script {
                    def jsonText = new File('C:/Jenkins/Jobs/tmp.json').text
                    def transfers = new JsonSlurperClassic().parseText(jsonText)
                    TOTAL = transfers.size()

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'WIN.SVC.UC4.BATCHUSER',
                            usernameVariable: 'FT_USER',
                            passwordVariable: 'FT_PASS'
                        )
                    ]) {
                        try {
                            transfers.each { transfer ->
                                if (transfer.containsKey('enabled') && !transfer.enabled) {
                                    DISABLED++
                                    DISABLED_JOBS << transfer.job?.toString()
                                    echo "[DISABLED] ${transfer.job}"
                                    return
                                }

                                String jobName       = transfer.job?.toString()
                                String credentialId  = transfer.credentialId?.toString()
                                String source        = transfer.source?.toString()
                                String destination   = transfer.destination?.toString()
                                String fileMask      = transfer.fileMask?.toString() ?: '*.*'
                                String transferType  = transfer.transferType?.toString()?.trim()?.toUpperCase() ?: 'ROBOCOPY'
                                String roboFlags     = ''

                                if (transfer.flags instanceof List) {
                                    roboFlags = transfer.flags.collect { it.toString() }.join(' ')
                                } else {
                                    roboFlags = transfer.flags?.toString() ?: ''
                                }

                                // ============================================================
                                // PRE-CHECK ligero
                                // ============================================================
                                if (transferType == 'ROBOCOPY' && credentialId == 'WIN.SVC.UC4.BATCHUSER') {
                                    CHECKED++
                                    int checkResult = bat(
                                        returnStatus: true,
                                        script: """
@echo off
setlocal EnableDelayedExpansion
set "SOURCE=${source}"
set "TEMP=!SOURCE:~2!"
for /f "tokens=1,2 delims=\\" %%a in ("!TEMP!") do (
    set "SERVER=%%a"
    set "SHARENAME=%%b"
)
set "SHARE=\\\\!SERVER!\\!SHARENAME!"
net use "!SHARE!" /delete /y >nul 2>&1
net use "!SHARE!" "%FT_PASS%" /user:"%FT_USER%" >nul 2>&1
if errorlevel 1 (
    exit /b 100
)
pushd "!SOURCE!" >nul 2>&1
if errorlevel 1 (
    net use "!SHARE!" /delete /y >nul 2>&1
    exit /b 100
)
popd >nul 2>&1
net use "!SHARE!" /delete /y >nul 2>&1
exit /b 0
"""
                                    )
                                    if (checkResult == 100) {
                                        // Child virtual (pre-check failed)
                                        CHILDREN << [
                                            job       : jobName,
                                            build     : null,
                                            status    : "FAILED",
                                            startTime : "—",
                                            endTime   : "—",
                                            duration  : "—",
                                            logFile   : null,
                                            reason    : "Source path not found or access denied"
                                        ]
                                        FAILURES << [
                                            job    : jobName,
                                            result : 'PRECHECK_FAILED',
                                            reason : 'Source path not found or access denied'
                                        ]
                                        echo "[FAIL] ${jobName} - PRECHECK_FAILED"
                                        return
                                    }
                                }

                                echo "[EXEC] ${jobName} (${transferType})"
                                def result

                                if (transferType == 'SHAREPOINT') {
                                    result = build(
                                        job: 'POC_SHAREPOINT_TRANSFER',
                                        wait: true,
                                        propagate: false,
                                        parameters: [
                                            string(name: 'JOB_NAME',     value: jobName),
                                            string(name: 'SRC_PATH',     value: source),
                                            string(name: 'SITE_URL',     value: destination),
                                            string(name: 'LIBRARY',      value: transfer.library?.toString() ?: 'Shared Documents'),
                                            string(name: 'FILE_MASK',    value: fileMask),
                                            string(name: 'OPERATION',    value: transfer.operation?.toString()?.toUpperCase() ?: 'COPY'),
                                            booleanParam(name: 'OVERWRITE', value: transfer.overwrite != false),
                                            string(name: 'SRC_CRED',     value: credentialId ?: 'WIN.SVC.UC4.BATCHUSER'),
                                            string(name: 'PARENT_BUILD', value: "${env.BUILD_NUMBER}")
                                        ]
                                    )
                                } else {
                                    result = build(
                                        job: 'POC_AUTOMIC_FILE_TRANSFER_IMPROVED_PEFORMANCE',
                                        wait: true,
                                        propagate: false,
                                        parameters: [
                                            string(name: 'JOB_NAME',        value: jobName),
                                            string(name: 'SRC_CRED',        value: credentialId),
                                            string(name: 'SRC_PATH',        value: source),
                                            string(name: 'DST_PATH',        value: destination),
                                            string(name: 'FILE_MASK',       value: fileMask),
                                            string(name: 'ROBOCOPY_FLAGS',  value: roboFlags),
                                            string(name: 'PARENT_BUILD',    value: "${env.BUILD_NUMBER}")
                                        ]
                                    )
                                }

                                // Tiempos del child real
                                long childStartMs  = result.startTimeInMillis ?: 0L
                                long childDuration = result.duration ?: 0L
                                long childEndMs    = (childStartMs > 0 && childDuration > 0) ? (childStartMs + childDuration) : 0L

                                EXECUTED++
                                CHILDREN << [
                                    job       : jobName,
                                    build     : result.number,
                                    status    : result.result,
                                    startTime : formatTime(childStartMs),
                                    endTime   : formatTime(childEndMs),
                                    duration  : formatDuration(childDuration),
                                    logFile   : "${jobName}_BuildID_${result.number}.txt",
                                    reason    : null
                                ]

                                if (result.result != 'SUCCESS') {
                                    FAILURES << [
                                        job    : jobName,
                                        result : result.result,
                                        build  : result.number,
                                        url    : result.absoluteUrl,
                                        reason : "Transfer returned ${result.result}"
                                    ]
                                    echo "[FAIL] ${jobName}"
                                } else {
                                    SUCCESS_JOBS << jobName
                                    echo "[SUCCESS] ${jobName}"
                                }
                            }
                        } finally {
                            // Optional cleanup
                        }
                    }

                    currentBuild.displayName = "#${env.BUILD_NUMBER} D:${DISABLED} X:${EXECUTED} S:${SKIPPED} F:${FAILURES.size()}"
                    currentBuild.description = "Total=${TOTAL} | Disabled=${DISABLED} | Checked=${CHECKED} | Executed=${EXECUTED} | Skipped=${SKIPPED} | Failed=${FAILURES.size()}"
                    
                    // Siempre SUCCESS en Jenkins
                    currentBuild.result = 'SUCCESS'
                }
            }
        }
    }

    post {
        always {
            script {
                // ============================================================
                // Tiempos del Parent
                // ============================================================
                long parentStartMs  = currentBuild.startTimeInMillis ?: 0L
                long parentDuration = currentBuild.duration ?: (System.currentTimeMillis() - parentStartMs)
                long parentEndMs    = parentStartMs + parentDuration

                String parentStartTime   = formatTime(parentStartMs)
                String parentEndTime     = formatTime(parentEndMs)
                String parentDurationStr = formatDuration(parentDuration)

                // ============================================================
                // Contadores reales de children
                // ============================================================
                def successCount  = CHILDREN.count { it.status == 'SUCCESS' }
                def failedCount   = CHILDREN.count { it.status == 'FAILED' || it.status == 'FAILURE' || it.status == 'PRECHECK_FAILED' }
                def unstableCount = CHILDREN.count { it.status == 'UNSTABLE' }

                // ============================================================
                // Console summary
                // ============================================================
                def summary = """
FT SUMMARY
========================================
FILE TRANSFER SUMMARY
========================================
Total    : ${TOTAL}
Disabled : ${DISABLED}
Checked  : ${CHECKED}
Executed : ${EXECUTED}
Skipped  : ${SKIPPED}
Failed   : ${FAILURES.size()}
========================================
"""
                if (!FAILURES.isEmpty()) {
                    summary += """
FAILED JOBS
========================================
"""
                    FAILURES.each { f ->
                        summary += """
JOB    : ${f.job}
RESULT : ${f.result}
REASON : ${f.reason}
----------------------------------------
"""
                    }
                    summary += "========================================\n"
                }
                echo(summary)

                // ============================================================
                // Detailed text log
                // ============================================================
                def logDir = 'C:\\Jenkins\\Jobs\\Log'
                def logFileName = "${env.JOB_NAME}_BuildID_${env.BUILD_NUMBER}.txt"
                def logFilePath = "${logDir}\\${logFileName}"

                bat """
@echo off
if not exist "${logDir}" mkdir "${logDir}"
"""

                def logContent = """
================================================================================
FILE TRANSFER ORCHESTRATOR - DETAILED EXECUTION LOG
================================================================================
Job Name      : ${env.JOB_NAME}
Build Number  : ${env.BUILD_NUMBER}
Build URL     : ${env.BUILD_URL}
Start Time    : ${parentStartTime}
End Time      : ${parentEndTime}
Duration      : ${parentDurationStr}
================================================================================
SUMMARY
--------------------------------------------------------------------------------
Total     : ${TOTAL}
Disabled  : ${DISABLED}
Checked   : ${CHECKED}
Executed  : ${EXECUTED}
Skipped   : ${SKIPPED}
Failed    : ${FAILURES.size()}
--------------------------------------------------------------------------------
DISABLED JOBS (${DISABLED})
--------------------------------------------------------------------------------
"""
                if (DISABLED_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    DISABLED_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
SKIPPED JOBS (${SKIPPED})
--------------------------------------------------------------------------------
"""
                if (SKIPPED_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    SKIPPED_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
SUCCESSFULLY EXECUTED JOBS (${SUCCESS_JOBS.size()})
--------------------------------------------------------------------------------
"""
                if (SUCCESS_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    SUCCESS_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
FAILED JOBS (${FAILURES.size()})
--------------------------------------------------------------------------------
"""
                if (FAILURES.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    FAILURES.each { f ->
                        logContent += """
  JOB     : ${f.job}
  RESULT  : ${f.result}
  REASON  : ${f.reason}
"""
                        if (f.build) logContent += "  BUILD   : #${f.build}\n"
                        if (f.url)   logContent += "  URL     : ${f.url}\n"
                        logContent += "  ----------------------------------------\n"
                    }
                }

                logContent += """
================================================================================
END OF LOG
================================================================================
"""
                writeFile file: logFilePath, text: logContent
                echo "Detailed log written to: ${logFilePath}"

                // ============================================================
                // Dashboard JSON (Build_xxx.json)
                // ============================================================
                def dashboardDir  = 'C:\\Jenkins\\Jobs\\Dashboard\\Builds'
                def dashboardFile = "${dashboardDir}\\Build_${env.BUILD_NUMBER}.json"

                bat """
@echo off
if not exist "${dashboardDir}" mkdir "${dashboardDir}"
"""

                // Parent siempre SUCCESS en el Dashboard
                def overallStatus = "SUCCESS"

                def dashboardJson = [
                    parentJob     : env.JOB_NAME,
                    parentBuild   : env.BUILD_NUMBER as Integer,
                    buildUrl      : env.BUILD_URL,
                    status        : overallStatus,
                    timestamp     : parentStartTime,
                    endTime       : parentEndTime,
                    duration      : parentDurationStr,
                    summary       : [
                        total     : TOTAL,
                        disabled  : DISABLED,
                        checked   : CHECKED,
                        executed  : EXECUTED,
                        skipped   : SKIPPED,
                        failed    : FAILURES.size()
                    ],
                    children      : CHILDREN,
                    successCount  : successCount,
                    failedCount   : failedCount,
                    unstableCount : unstableCount
                ]

                def jsonText = JsonOutput.prettyPrint(JsonOutput.toJson(dashboardJson))
                writeFile file: dashboardFile, text: jsonText
                echo "Dashboard JSON written to: ${dashboardFile}"

                // ============================================================
                // Dashboard INDEX (index.json)
                // ============================================================
                def indexFile      = 'C:\\Jenkins\\Jobs\\Dashboard\\index.json'
                def workspaceIndex = "${env.WORKSPACE}\\dashboard_index_temp.json"

                bat """
@echo off
if not exist "C:\\Jenkins\\Jobs\\Dashboard" mkdir "C:\\Jenkins\\Jobs\\Dashboard"
"""

                def indexRecord = [
                    build         : env.BUILD_NUMBER.toInteger(),
                    job           : env.JOB_NAME,
                    status        : overallStatus,
                    timestamp     : parentStartTime,
                    endTime       : parentEndTime,
                    duration      : parentDurationStr,
                    children      : CHILDREN.size(),
                    successCount  : successCount,
                    failedCount   : failedCount,
                    unstableCount : unstableCount,
                    file          : "Build_${env.BUILD_NUMBER}.json"
                ]

                bat """
@echo off
if exist "${indexFile}" (
    copy /Y "${indexFile}" "${workspaceIndex}" >nul
) else (
    echo []> "${workspaceIndex}"
)
"""

                def indexData = []
                try {
                    def raw = readFile(file: workspaceIndex).trim()
                    if (raw && raw != '[]') {
                        def parsed = new JsonSlurperClassic().parseText(raw)
                        if (parsed instanceof List) {
                            indexData = new ArrayList(parsed)
                        }
                    }
                } catch (Exception e) {
                    echo "WARNING: Failed to parse index, starting fresh: ${e.message}"
                    indexData = []
                }

                def currentBuildNum = env.BUILD_NUMBER.toInteger()
                indexData = filterOutBuild(indexData, currentBuildNum)
                indexData.add(0, indexRecord)
                indexData = sortIndexDesc(indexData)

                def prettyIndex = JsonOutput.prettyPrint(JsonOutput.toJson(indexData))
                writeFile file: workspaceIndex, text: prettyIndex

                bat """
@echo off
copy /Y "${workspaceIndex}" "${indexFile}" >nul
"""

                echo "Dashboard index updated: ${indexFile}"
                echo "Total builds in index: ${indexData.size()}"
            }
        }
    }
}
