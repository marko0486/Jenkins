import groovy.json.JsonSlurperClassic

// ============================================================================
// GLOBAL EXECUTION COUNTERS AND LISTS
// ============================================================================
def TOTAL          = 0
def DISABLED       = 0
def CHECKED        = 0
def EXECUTED       = 0
def SKIPPED        = 0
def FAILURES       = []
def DISABLED_JOBS  = []
def SKIPPED_JOBS   = []
def SUCCESS_JOBS   = []

pipeline {
    agent {
        label 'built-in'
    }
    options {
        disableConcurrentBuilds()
    }
    stages {
        stage('File Transfers') {
            steps {
                script {
                    def jsonText = new File('C:/Jenkins/Jobs/tmp.json').text
                    def transfers = new JsonSlurperClassic().parseText(jsonText)
                    TOTAL = transfers.size()

                    withCredentials([
                        usernamePassword(
                            credentialsId: 'WIN.SVC.UC4.BATCHUSER',
                            usernameVariable: 'FT_USER',
                            passwordVariable: 'FT_PASS'
                        )
                    ]) {
                        try {
                            transfers.each { transfer ->

                                if (transfer.containsKey('enabled') && !transfer.enabled) {
                                    DISABLED++
                                    DISABLED_JOBS << transfer.job?.toString()
                                    echo "[DISABLED] ${transfer.job}"
                                    return
                                }

                                String jobName       = transfer.job?.toString()
                                String credentialId  = transfer.credentialId?.toString()
                                String source        = transfer.source?.toString()
                                String destination   = transfer.destination?.toString()
                                String fileMask      = transfer.fileMask?.toString() ?: '*.*'
                                String transferType  = transfer.transferType?.toString()?.trim()?.toUpperCase() ?: 'ROBOCOPY'
                                String roboFlags     = ''

                                if (transfer.flags instanceof List) {
                                    roboFlags = transfer.flags.collect { it.toString() }.join(' ')
                                } else {
                                    roboFlags = transfer.flags?.toString() ?: ''
                                }

                                // ============================================================
                                // PRE-CHECK (only for ROBOCOPY with the common credential)
                                // ============================================================
                                if (transferType == 'ROBOCOPY' && credentialId == 'WIN.SVC.UC4.BATCHUSER') {
                                    CHECKED++

                                    int checkResult = bat(
                                        returnStatus: true,
                                        script: """
@echo off
setlocal enabledelayedexpansion

REM ------------------------------------------------------------
REM Extract the share root from the source path
REM Example:
REM   \\\\FRDV02656.emea.zf-world.com\\ToolShare\\tmp\\src
REM   %%a = FRDV02656.emea.zf-world.com
REM   %%b = ToolShare
REM   SHARE = \\\\FRDV02656.emea.zf-world.com\\ToolShare
REM ------------------------------------------------------------
set "SOURCE=${source}"
for /f "tokens=1,2 delims=\\" %%a in ("!SOURCE!") do (
    set "SHARE=\\\\%%a\\%%b"
)

echo Authenticating share: !SHARE!

REM Clean up any potential stale connections
net use "!SHARE!" /delete /y >nul 2>&1

REM Authenticate the network share
net use "!SHARE!" %FT_PASS% /user:%FT_USER% >nul 2>&1

REM Attempt to enter the source path
pushd "!SOURCE!" >nul 2>&1
if errorlevel 1 (
    exit /b 100
)

REM Check for matching files
dir "${fileMask}" /b /a-d | findstr . >nul
set RC=!ERRORLEVEL!
popd >nul 2>&1

exit /b !RC!
"""
                                    )

                                    if (checkResult == 100) {
                                        FAILURES << [
                                            job    : jobName,
                                            result : 'PRECHECK_FAILED',
                                            reason : 'Source path not found or access denied'
                                        ]
                                        echo "[FAIL] ${jobName}"
                                        return
                                    }

                                    if (checkResult != 0) {
                                        SKIPPED++
                                        SKIPPED_JOBS << jobName
                                        echo "[SKIP] ${jobName}"
                                        return
                                    }
                                }

                                echo "[EXEC] ${jobName} (${transferType})"
                                def result

                                if (transferType == 'SHAREPOINT') {
                                    result = build(
                                        job: 'POC_SHAREPOINT_TRANSFER',
                                        wait: true,
                                        propagate: false,
                                        parameters: [
                                            string(name: 'JOB_NAME',     value: jobName),
                                            string(name: 'SRC_PATH',     value: source),
                                            string(name: 'SITE_URL',     value: destination),
                                            string(name: 'LIBRARY',      value: transfer.library?.toString() ?: 'Shared Documents'),
                                            string(name: 'FILE_MASK',    value: fileMask),
                                            string(name: 'OPERATION',    value: transfer.operation?.toString()?.toUpperCase() ?: 'COPY'),
                                            booleanParam(name: 'OVERWRITE', value: transfer.overwrite != false),
                                            string(name: 'SRC_CRED',     value: credentialId ?: 'WIN.SVC.UC4.BATCHUSER'),
                                            string(name: 'PARENT_BUILD', value: "${env.BUILD_NUMBER}")
                                        ]
                                    )
                                } else {
                                    result = build(
                                        job: 'POC_AUTOMIC_FILE_TRANSFER_IMPROVED_PEFORMANCE',
                                        wait: true,
                                        propagate: false,
                                        parameters: [
                                            string(name: 'JOB_NAME',        value: jobName),
                                            string(name: 'SRC_CRED',        value: credentialId),
                                            string(name: 'SRC_PATH',        value: source),
                                            string(name: 'DST_PATH',        value: destination),
                                            string(name: 'FILE_MASK',       value: fileMask),
                                            string(name: 'ROBOCOPY_FLAGS',  value: roboFlags)
                                        ]
                                    )
                                }

                                EXECUTED++

                                if (result.result != 'SUCCESS') {
                                    FAILURES << [
                                        job    : jobName,
                                        result : result.result,
                                        build  : result.number,
                                        url    : result.absoluteUrl,
                                        reason : "Transfer returned ${result.result}"
                                    ]
                                    echo "[FAIL] ${jobName}"
                                } else {
                                    SUCCESS_JOBS << jobName
                                    echo "[SUCCESS] ${jobName}"
                                }
                            }
                        } finally {
                            // Optional: clean up mappings if needed
                        }
                    }

                    currentBuild.displayName = "#${env.BUILD_NUMBER} D:${DISABLED} X:${EXECUTED} S:${SKIPPED} F:${FAILURES.size()}"
                    currentBuild.description = "Total=${TOTAL} | Disabled=${DISABLED} | Checked=${CHECKED} | Executed=${EXECUTED} | Skipped=${SKIPPED} | Failed=${FAILURES.size()}"
                    currentBuild.result = 'SUCCESS'
                }
            }
        }
    }

    post {
        always {
            script {
                def summary = """
FT SUMMARY
========================================
FILE TRANSFER SUMMARY
========================================
Total    : ${TOTAL}
Disabled : ${DISABLED}
Checked  : ${CHECKED}
Executed : ${EXECUTED}
Skipped  : ${SKIPPED}
Failed   : ${FAILURES.size()}
========================================
"""
                if (!FAILURES.isEmpty()) {
                    summary += """
FAILED JOBS
========================================
"""
                    FAILURES.each { f ->
                        summary += """
JOB    : ${f.job}
RESULT : ${f.result}
REASON : ${f.reason}
----------------------------------------
"""
                    }
                    summary += "========================================\n"
                }
                echo(summary)

                // Detailed log file
                def logDir = 'C:\\Jenkins\\Jobs\\Log'
                def dateStr = new Date().format('yyyyMMdd')
                def logFileName = "${env.JOB_NAME}_${dateStr}_BuildID_${env.BUILD_NUMBER}.txt"
                def logFilePath = "${logDir}\\${logFileName}"

                bat """
@echo off
if not exist "${logDir}" mkdir "${logDir}"
"""

                def logContent = """
================================================================================
FILE TRANSFER ORCHESTRATOR - DETAILED EXECUTION LOG
================================================================================
Job Name      : ${env.JOB_NAME}
Build Number  : ${env.BUILD_NUMBER}
Build URL     : ${env.BUILD_URL}
Timestamp     : ${new Date().format('yyyy-MM-dd HH:mm:ss')}
================================================================================
SUMMARY
--------------------------------------------------------------------------------
Total     : ${TOTAL}
Disabled  : ${DISABLED}
Checked   : ${CHECKED}
Executed  : ${EXECUTED}
Skipped   : ${SKIPPED}
Failed    : ${FAILURES.size()}
--------------------------------------------------------------------------------
DISABLED JOBS (${DISABLED})
--------------------------------------------------------------------------------
"""
                if (DISABLED_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    DISABLED_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
SKIPPED JOBS (${SKIPPED})
--------------------------------------------------------------------------------
"""
                if (SKIPPED_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    SKIPPED_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
SUCCESSFULLY EXECUTED JOBS (${SUCCESS_JOBS.size()})
--------------------------------------------------------------------------------
"""
                if (SUCCESS_JOBS.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    SUCCESS_JOBS.each { job -> logContent += "  - ${job}\n" }
                }

                logContent += """
FAILED JOBS (${FAILURES.size()})
--------------------------------------------------------------------------------
"""
                if (FAILURES.isEmpty()) {
                    logContent += "  (none)\n"
                } else {
                    FAILURES.each { f ->
                        logContent += """
  JOB     : ${f.job}
  RESULT  : ${f.result}
  REASON  : ${f.reason}
"""
                        if (f.build) logContent += "  BUILD   : #${f.build}\n"
                        if (f.url)   logContent += "  URL     : ${f.url}\n"
                        logContent += "  ----------------------------------------\n"
                    }
                }

                logContent += """
================================================================================
END OF LOG
================================================================================
"""
                writeFile file: logFilePath, text: logContent
                echo "Detailed log written to: ${logFilePath}"
            }
        }
    }
}


